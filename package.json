{
  "name": "church-directory",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply church-directory --local --persist-to .wrangler/state",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:geocode": "node --experimental-strip-types scripts/geocode.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.16.6",
    "jose": "^6.2.6",
    "leaflet": "^1.9.4",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.59.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260115.0",
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.7.3"
  }
}
