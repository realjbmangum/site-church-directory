---
import '../styles/global.css';

interface Props {
  title: string;
  flash?: string | null;
  error?: string | null;
}

const { title, flash, error } = Astro.props;
const links = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/submissions', label: 'Submissions' },
  { href: '/admin/edits', label: 'Edits' },
  { href: '/admin/checks', label: 'Checks' },
  { href: '/admin/inbox', label: 'Inbox' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Desk</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Familjen+Grotesk:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-cream-100 text-gray-800">
    <header class="bg-white border-b border-cream-300">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-3">
        <a href="/admin" class="wordmark" style="color: var(--ink)">Review desk</a>
        <a href="/" class="btn-quiet">View the public site</a>
      </div>
      <nav class="max-w-6xl mx-auto px-4 pb-4 flex flex-wrap gap-2" aria-label="Desk">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['chip', path === link.href && 'btn-primary']}
            aria-current={path === link.href ? 'page' : undefined}
            style={path === link.href ? 'color: var(--on-spruce)' : undefined}
          >{link.label}</a>
        ))}
      </nav>
    </header>
    <main class="max-w-6xl mx-auto px-4 py-8">
      {flash && <p class="mb-4 rounded-xl border border-cream-300 bg-white px-4 py-3 text-sm">{flash}</p>}
      {error && <p class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">{error}</p>}
      <slot />
    </main>
  </body>
</html>
