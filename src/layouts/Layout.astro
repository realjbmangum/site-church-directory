---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = 'Find a church in the Charlotte area. Listings are checked against each church website, with service times, denomination, language, and a proof link.',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Find a Church';
const fullTitle = title === 'Home' ? `${siteName} | Charlotte church directory` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const blocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const year = new Date().getFullYear();

const nav = [
  { href: '/churches', label: 'Churches' },
  { href: '/map', label: 'Map' },
  { href: '/denominations', label: 'Denominations' },
  { href: '/cities', label: 'Cities' },
  { href: '/analytics', label: 'Analytics' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,560;8..60,680&display=swap" rel="stylesheet" />
    {blocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:rounded-lg">Skip to content</a>
    <header class="bg-cream-50/95 border-b border-cream-300 sticky top-0 z-40 backdrop-blur">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between gap-4 h-16">
          <a href="/" class="flex items-center gap-2 min-w-0">
            <span class="font-serif text-xl text-gray-900 tracking-tight">Find a Church</span>
            <span class="hidden sm:inline badge">Charlotte</span>
          </a>
          <nav class="hidden lg:flex items-center gap-5 text-sm text-gray-700" aria-label="Primary">
            {nav.map((item) => (
              <a href={item.href} class="hover:text-primary-700">{item.label}</a>
            ))}
          </nav>
          <a href="/submit" class="btn-primary text-sm px-4 py-2">Add a church</a>
        </div>
        <nav class="lg:hidden flex gap-4 overflow-x-auto pb-3 text-sm text-gray-700" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} class="shrink-0 hover:text-primary-700">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-cream-300 bg-cream-50 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2">
          <p class="font-serif text-xl text-gray-900">Find a Church</p>
          <p class="mt-2 text-gray-600 max-w-md">
            A Charlotte pilot. Each seeded listing keeps a quote from the church's own website, the page where we read it, and the date we checked.
          </p>
        </div>
        <div>
          <p class="font-medium text-gray-900 mb-2">Browse</p>
          <ul class="space-y-1.5 text-gray-600">
            <li><a class="hover:text-primary-700" href="/charlotte">Charlotte metro</a></li>
            <li><a class="hover:text-primary-700" href="/map">Map</a></li>
            <li><a class="hover:text-primary-700" href="/denominations">Denominations</a></li>
            <li><a class="hover:text-primary-700" href="/analytics">Analytics</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium text-gray-900 mb-2">Corrections</p>
          <ul class="space-y-1.5 text-gray-600">
            <li><a class="hover:text-primary-700" href="/about">How listings work</a></li>
            <li><a class="hover:text-primary-700" href="/submit">Submit a church</a></li>
            <li><a class="hover:text-primary-700" href="/suggest-edit">Suggest an edit</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-cream-300">
        <p class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-sm text-gray-500">© {year} Find a Church. Charlotte pilot.</p>
      </div>
    </footer>
  </body>
</html>
