---
import '../styles/global.css';
import ScenicPhoto from '../components/ScenicPhoto.astro';
import { SITE_NAME, canonicalUrl, jsonLdScript } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  path: string;
  noindex?: boolean;
  jsonLd?: unknown;
}

const {
  title,
  description = 'Find a church in the Charlotte area. Service times are checked against each church’s own website.',
  path,
  noindex = false,
  jsonLd,
} = Astro.props;

const home = path === '/';
const fullTitle = home ? `${SITE_NAME} | Charlotte church directory` : `${title} | ${SITE_NAME}`;
const canonical = canonicalUrl(path);
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: canonicalUrl('/'),
  description: 'A directory of churches in the Charlotte area, checked against their own websites.',
};
const nav = [
  { href: '/charlotte', label: 'Charlotte' },
  { href: '/map', label: 'Map' },
  { href: '/denomination', label: 'Church types' },
  { href: '/analytics', label: 'The numbers' },
  { href: '/about', label: 'About' },
];

function current(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {home && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        href="/hero/church-1280.webp"
        imagesrcset="/hero/church-800.webp 800w, /hero/church-1280.webp 1280w, /hero/church-1920.webp 1920w"
        imagesizes="100vw"
      />
    )}
    <script type="application/ld+json" set:html={jsonLdScript(jsonLd ?? websiteLd)} />
  </head>
  <body class:list={['min-h-screen flex flex-col', home && 'is-home']}>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav class="wrap" aria-label="Primary">
        <div class="header-bar">
          <a href="/" class="wordmark">Find a Church</a>
          <div class="nav-links">
            {nav.map((item) => (
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
          <a href="/submit" class="header-action">Add a church</a>
        </div>
        <details class="nav-mobile">
          <summary>Browse</summary>
          <div class="nav-mobile-panel">
            {nav.map((item) => (
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </details>
      </nav>
    </header>
    {!home && (
      <div class="page-band" aria-hidden="true">
        <ScenicPhoto variant="band" />
      </div>
    )}
    <main id="content" class="flex-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="wordmark" style="color: var(--ink)">Find a Church</p>
          <p class="mt-2">Charlotte is the pilot. Each listing keeps a quote from the church’s own site and the date we checked it.</p>
        </div>
        <div>
          <h2>Browse</h2>
          <ul>
            <li><a href="/map">Map and filters</a></li>
            <li><a href="/charlotte">Charlotte metro</a></li>
            <li><a href="/denomination">Church types</a></li>
            <li><a href="/analytics">What the area looks like</a></li>
          </ul>
        </div>
        <div>
          <h2>Corrections</h2>
          <ul>
            <li><a href="/submit">Submit a church</a></li>
            <li><a href="/about">How a listing gets checked</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap legal">© {new Date().getFullYear()} Find a Church. Listings stay in the directory when a church closes. They are not deleted.</p>
    </footer>
  </body>
</html>
