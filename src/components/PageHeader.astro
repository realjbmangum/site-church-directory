---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}

const { title, lede, crumbs = [] } = Astro.props;
---

<header class="bg-cream-50 border-b border-cream-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-3 text-sm text-gray-600">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li><a class="hover:text-primary-700" href="/">Home</a></li>
          {crumbs.map((crumb) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {crumb.href ? <a class="hover:text-primary-700" href={crumb.href}>{crumb.label}</a> : <span class="text-gray-800">{crumb.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="font-serif text-3xl sm:text-4xl text-gray-900">{title}</h1>
    {lede && <p class="mt-3 text-lg text-gray-600 max-w-3xl">{lede}</p>}
  </div>
</header>
