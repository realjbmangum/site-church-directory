---
/**
 * Sunrise photograph generated for Find a Church.
 * It is not a picture of a congregation in this directory.
 * Prompt and sizes are recorded in public/hero/credit.json.
 */
interface Props {
  variant: 'hero' | 'band';
}

const { variant } = Astro.props;
const hero = variant === 'hero';
---

<picture class={hero ? 'hero-media' : 'band-media'}>
  {hero ? (
    <>
      <source
        type="image/avif"
        srcset="/hero/church-800.avif 800w, /hero/church-1280.avif 1280w, /hero/church-1920.avif 1920w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/hero/church-800.webp 800w, /hero/church-1280.webp 1280w, /hero/church-1920.webp 1920w"
        sizes="100vw"
      />
      <img src="/hero/church-1600.jpg" alt="" width="1920" height="1080" decoding="async" fetchpriority="high" />
    </>
  ) : (
    <>
      <source type="image/avif" srcset="/hero/band-960.avif 960w, /hero/band-1600.avif 1600w" sizes="100vw" />
      <source type="image/webp" srcset="/hero/band-960.webp 960w, /hero/band-1600.webp 1600w" sizes="100vw" />
      <img src="/hero/band-1280.jpg" alt="" width="1600" height="420" decoding="async" />
    </>
  )}
</picture>
