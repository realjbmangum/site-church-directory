---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Find Your Church Community",
  subtitle = "Discover welcoming churches near you. Search by location, denomination, or service times."
} = Astro.props;

const denominations = [
  "All Denominations",
  "Baptist",
  "Catholic",
  "Episcopal",
  "Lutheran",
  "Methodist",
  "Non-Denominational",
  "Presbyterian",
  "Pentecostal",
  "Other"
];
---

<section class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-accent-800 py-16 md:py-24">
  <!-- Decorative pattern -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <pattern id="church-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M20 5v10M15 10h10M20 25v10M15 30h10" stroke="currentColor" stroke-width="1" fill="none"/>
      </pattern>
      <rect width="100%" height="100%" fill="url(#church-pattern)"/>
    </svg>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-4">
      {title}
    </h1>
    <p class="text-lg md:text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
      {subtitle}
    </p>

    <!-- Search Form -->
    <form action="/churches" method="GET" class="bg-white rounded-2xl shadow-xl p-4 md:p-6 max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <!-- Location Input -->
        <div class="md:col-span-5">
          <label for="location" class="sr-only">Location</label>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <input
              type="text"
              id="location"
              name="location"
              placeholder="City, State or ZIP"
              class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-gray-800"
            />
          </div>
        </div>

        <!-- Denomination Select -->
        <div class="md:col-span-4">
          <label for="denomination" class="sr-only">Denomination</label>
          <select
            id="denomination"
            name="denomination"
            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent text-gray-800 bg-white"
          >
            {denominations.map(d => (
              <option value={d === "All Denominations" ? "" : d.toLowerCase()}>{d}</option>
            ))}
          </select>
        </div>

        <!-- Search Button -->
        <div class="md:col-span-3">
          <button type="submit" class="w-full btn-primary py-3">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search
          </button>
        </div>
      </div>

      <!-- Quick Filters -->
      <div class="flex flex-wrap justify-center gap-2 mt-4 pt-4 border-t border-gray-100">
        <span class="text-sm text-gray-500">Popular:</span>
        <a href="/churches?day=sunday" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">Sunday Services</a>
        <span class="text-gray-300">|</span>
        <a href="/churches?feature=youth" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">Youth Programs</a>
        <span class="text-gray-300">|</span>
        <a href="/churches?feature=childcare" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">Children's Ministry</a>
        <span class="text-gray-300">|</span>
        <a href="/churches?style=contemporary" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">Contemporary Worship</a>
      </div>
    </form>
  </div>
</section>
