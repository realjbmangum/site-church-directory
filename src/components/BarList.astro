---
interface Props {
  title: string;
  rows: { label: string; count: number; href?: string }[];
}

const { title, rows } = Astro.props;
const max = Math.max(1, ...rows.map((row) => row.count));
---

<section class="chart-card">
  <h2>{title}</h2>
  {rows.length === 0 ? (
    <p class="quiet" style="margin-top: 0.75rem">Nothing to chart yet.</p>
  ) : (
    <ul class="bars">
      {rows.map((row) => (
        <li>
          <div class="bar-label">
            {row.href ? <a href={row.href}>{row.label}</a> : <span>{row.label}</span>}
            <span class="bar-count">{row.count}</span>
          </div>
          <div class="bar-track" aria-hidden="true">
            <div class="bar-fill" style={`width: ${Math.max(4, (row.count / max) * 100)}%`}></div>
          </div>
        </li>
      ))}
    </ul>
  )}
</section>
