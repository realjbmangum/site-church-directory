---
interface Props {
  title: string;
  rows: { label: string; count: number; href?: string }[];
}

const { title, rows } = Astro.props;
const max = Math.max(1, ...rows.map((row) => row.count));
---

<section class="card p-5">
  <h2 class="font-serif text-xl text-gray-900">{title}</h2>
  {rows.length === 0 ? (
    <p class="mt-3 text-sm text-gray-600">Nothing to chart yet.</p>
  ) : (
    <ul class="mt-4 space-y-3">
      {rows.map((row) => (
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm">
            {row.href ? <a href={row.href} class="text-gray-900 hover:text-primary-700">{row.label}</a> : <span>{row.label}</span>}
            <span class="tabular-nums text-gray-600">{row.count}</span>
          </div>
          <div class="mt-1 h-2 rounded-full bg-cream-200">
            <div class="h-2 rounded-full bg-primary-500" style={`width: ${Math.max(4, (row.count / max) * 100)}%`}></div>
          </div>
        </li>
      ))}
    </ul>
  )}
</section>
