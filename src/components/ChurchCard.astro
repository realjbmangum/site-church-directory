---
import { mediaUrl, placeLine, snippet } from '../lib/format';

interface Props {
  slug: string;
  name: string;
  familyName?: string | null;
  bodyName?: string | null;
  city?: string | null;
  state?: string | null;
  serviceTimes?: string | null;
  sunday?: string | null;
  languages?: string | null;
  photoKey?: string | null;
  historicallyBlack?: boolean;
  heading?: 'h2' | 'h3';
}

const {
  slug,
  name,
  familyName,
  bodyName,
  city,
  state,
  serviceTimes,
  sunday,
  languages,
  photoKey,
  historicallyBlack,
  heading = 'h2',
} = Astro.props;
const photo = mediaUrl(photoKey);
const line = snippet(serviceTimes, 120);
const Heading = heading;
---

<a href={`/church/${slug}`} class="stop-card">
  {photo && <img src={photo} alt="" class="stop-photo" />}
  <p class="stop-time">{sunday || 'Time not listed'}</p>
  <div>
    <Heading class="stop-name">{name}</Heading>
    <p class="stop-place">{placeLine({ city, state })}</p>
    <p class="stop-meta">{familyName || 'Church type not listed yet'}</p>
    {!sunday && line && <p class="stop-meta">{line}</p>}
    {(historicallyBlack || (languages && languages !== 'English')) && (
      <p class="chip-row" style="margin-top: 0.55rem">
        {historicallyBlack && <span class="badge">Historically Black tradition</span>}
        {languages && languages !== 'English' && <span class="badge">{languages}</span>}
      </p>
    )}
  </div>
</a>
