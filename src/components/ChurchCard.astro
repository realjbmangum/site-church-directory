---
interface Service {
  day: string;
  time: string;
  type: string;
}

interface Props {
  slug: string;
  name: string;
  denomination: string;
  city: string;
  state: string;
  services: Service[];
  programs: string[];
  rating: number;
  review_count: number;
  photo: string;
  description: string;
  atmosphere?: string;
}

const { slug, name, denomination, city, state, services, programs, rating, review_count, photo, description, atmosphere } = Astro.props;

// Get next service
const today = new Date().getDay();
const dayOrder = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const nextService = services.find(s => dayOrder.indexOf(s.day) >= today) || services[0];
---

<a href={`/church/${slug}`} class="card group block">
  <div class="aspect-[16/10] relative overflow-hidden">
    <img
      src={photo}
      alt={name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <div class="absolute top-3 left-3">
      <span class="badge badge-denomination">{denomination}</span>
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-start justify-between gap-2 mb-2">
      <h3 class="font-serif text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors line-clamp-1">
        {name}
      </h3>
      <div class="flex items-center gap-1 shrink-0">
        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="text-sm font-medium text-gray-700">{rating}</span>
        <span class="text-sm text-gray-400">({review_count})</span>
      </div>
    </div>

    <p class="text-sm text-gray-500 mb-3">
      <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {city}, {state}
    </p>

    <p class="text-sm text-gray-600 line-clamp-2 mb-4">{description}</p>

    <!-- Next Service -->
    <div class="flex items-center gap-2 text-sm bg-cream-100 rounded-lg px-3 py-2 mb-3">
      <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-gray-700">
        <strong>{nextService.day}</strong> {nextService.time} - {nextService.type}
      </span>
    </div>

    <!-- Programs Preview -->
    <div class="flex flex-wrap gap-1.5">
      {programs.slice(0, 3).map(program => (
        <span class="badge badge-service">{program}</span>
      ))}
      {programs.length > 3 && (
        <span class="badge bg-gray-100 text-gray-600">+{programs.length - 3} more</span>
      )}
    </div>
  </div>
</a>
