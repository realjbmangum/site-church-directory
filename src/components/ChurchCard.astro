---
interface Props {
  church: {
    slug: string;
    name: string;
    familyName: string;
    familySlug: string;
    bodyName: string;
    bodySlug: string;
    city: string | null;
    state: string | null;
    postalCode: string | null;
    languages: string[];
    earliestSundayTime: string | null;
    serviceTimesText: string;
    historicallyBlack: boolean;
  };
}

const { church } = Astro.props;
const place = [church.city, church.state].filter(Boolean).join(', ');
const extraLanguages = church.languages.filter((language) => language.toLowerCase() !== 'english');
const when = church.earliestSundayTime
  ? `Sunday from ${church.earliestSundayTime}`
  : church.serviceTimesText;
---

<a
  href={`/churches/${church.slug}`}
  class="church-card card group block p-5 h-full"
  data-family={church.familySlug}
  data-body={church.bodySlug}
  data-city={church.city || ''}
  data-zip={church.postalCode || ''}
  data-languages={church.languages.join('|')}
  data-saturday={/saturday/i.test(church.serviceTimesText) ? '1' : '0'}
>
  <div class="flex flex-wrap gap-2 mb-3">
    <span class="badge">{church.familyName}</span>
    {church.historicallyBlack && <span class="badge">Historically Black tradition</span>}
  </div>
  <h3 class="font-serif text-xl text-gray-900 group-hover:text-primary-700">{church.name}</h3>
  {place && <p class="mt-1 text-sm text-gray-600">{place}{church.postalCode ? ` ${church.postalCode}` : ''}</p>}
  <p class="mt-3 text-sm text-gray-700 line-clamp-2">{when}</p>
  {extraLanguages.length > 0 && (
    <p class="mt-2 text-sm text-gray-600">Also in {extraLanguages.join(', ')}</p>
  )}
</a>
