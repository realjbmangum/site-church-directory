---
import { mediaUrl, placeLine, snippet } from '../lib/format';

interface Props {
  slug: string;
  name: string;
  familyName?: string | null;
  bodyName?: string | null;
  city?: string | null;
  state?: string | null;
  serviceTimes?: string | null;
  sunday?: string | null;
  languages?: string | null;
  photoKey?: string | null;
  historicallyBlack?: boolean;
}

const { slug, name, familyName, bodyName, city, state, serviceTimes, sunday, languages, photoKey, historicallyBlack } = Astro.props;
const photo = mediaUrl(photoKey);
const line = snippet(serviceTimes, 120);
---

<a href={`/church/${slug}`} class="card group block p-5 h-full hover:border-primary-300">
  {photo && (
    <img src={photo} alt="" class="w-full h-40 object-cover rounded-xl mb-4" />
  )}
  <p class="text-sm text-primary-800">{familyName || 'Denomination not stated'}</p>
  <h2 class="font-serif text-xl text-gray-900 mt-1 group-hover:text-primary-800">{name}</h2>
  <p class="text-sm text-gray-600 mt-1">{placeLine({ city, state })}</p>
  {bodyName && <p class="text-sm text-gray-600 mt-2">{bodyName}</p>}
  {historicallyBlack && <p class="mt-2"><span class="badge">Historically Black tradition</span></p>}
  {sunday && <p class="mt-3 text-sm bg-cream-100 rounded-lg px-3 py-2">Earliest Sunday service: {sunday}</p>}
  {!sunday && line && <p class="mt-3 text-sm text-gray-700">{line}</p>}
  {languages && languages !== 'English' && <p class="mt-3 text-sm text-gray-600">Languages: {languages}</p>}
</a>
