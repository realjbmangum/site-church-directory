---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DatabaseMissing from '../../components/DatabaseMissing.astro';
import { getDb } from '../../lib/db';
import { listInbox } from '../../lib/queries';

const db = getDb(Astro.locals);
const rows = db ? await listInbox(db) : [];
---

<AdminLayout title="Inbox">
  {db ? (
    <>
      <h1 class="font-serif text-3xl">Inbox</h1>
      <p class="mt-2 max-w-2xl text-gray-700">Mail that arrives at the church directory inbox is stored here. Reading it does not change a listing. The inbox worker never writes to the church tables.</p>
      {rows.length === 0 ? (
        <p class="mt-6 card p-4">No messages yet. The inbox worker is separate and is not turned on until email routing is approved.</p>
      ) : (
        <ul class="mt-6 space-y-4">
          {rows.map((row) => (
            <li class="card p-4">
              <p class="text-sm text-gray-500">{row.received_at}</p>
              <h2 class="font-serif text-xl mt-1">{row.subject || '(no subject)'}</h2>
              <p class="text-sm text-gray-700 mt-1">{row.sender_name || ''} {row.sender_email ? `<${row.sender_email}>` : ''}</p>
              {row.church_slug && <p class="text-sm mt-2">Matched {row.match_method}: <a class="text-primary-800" href={`/church/${row.church_slug}`}>{row.church_name}</a></p>}
              {row.forward_error && <p class="text-sm mt-2">Forward note: {row.forward_error}</p>}
              {row.text_body && <pre class="mt-3 whitespace-pre-wrap text-sm bg-cream-100 rounded-lg p-3">{row.text_body.slice(0, 2000)}</pre>}
            </li>
          ))}
        </ul>
      )}
    </>
  ) : <DatabaseMissing />}
</AdminLayout>
