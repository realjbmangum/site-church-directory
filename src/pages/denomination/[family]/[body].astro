---
import { getDb } from '../../../lib/db';
import { getBody } from '../../../lib/queries';
import { churchTypeName, churchTypeSlug } from '@shared/church-types';

const db = getDb(Astro.locals);
const body = db ? await getBody(db, Astro.params.family ?? '', Astro.params.body ?? '') : null;
if (body) {
  const type = churchTypeName(body.family_name, body.name, null);
  return Astro.redirect(`/denomination/${churchTypeSlug(type)}`);
}
Astro.response.status = 404;
---

<p>That page has moved. <a href="/denomination">Church types</a></p>
