---
import Layout from '../../layouts/Layout.astro';
import DatabaseMissing from '../../components/DatabaseMissing.astro';
import { getDb } from '../../lib/db';
import { listFamilies } from '../../lib/queries';

const db = getDb(Astro.locals);
const families = db ? await listFamilies(db) : [];
const withChurches = families.filter((family) => family.church_count > 0);
const empty = families.filter((family) => family.church_count === 0);
---

<Layout
  title="Denominations"
  path="/denomination"
  description="Denomination families in the Charlotte church directory, from Baptist to the bodies whose tradition is not stated."
>
  {db ? (
    <div class="page wrap">
      <h1>Denomination families</h1>
      <p class="lede">The taxonomy has {families.length} families. {withChurches.length} of them have at least one church in this pilot. A family page lists the specific bodies under it.</p>
      <ul class="legend legend-split" style="margin-top: 1.5rem">
        {withChurches.map((family) => (
          <li>
            <a href={`/denomination/${family.slug}`}>
              <span>{family.name}</span>
              <span class="legend-meta">{family.church_count}</span>
            </a>
          </li>
        ))}
      </ul>
      {empty.length > 0 && (
        <section class="section">
          <h2>No churches in the pilot yet</h2>
          <div class="chip-row">
            {empty.map((family) => (
              <a class="chip" href={`/denomination/${family.slug}`}>{family.name}</a>
            ))}
          </div>
        </section>
      )}
    </div>
  ) : <DatabaseMissing />}
</Layout>
