---
import Layout from '../layouts/Layout.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { CHURCH_TYPE_ORDER } from '@shared/church-type-data';

const db = getDb(Astro.locals);
const types = CHURCH_TYPE_ORDER;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout
  title="Add a church"
  path="/submit"
  description="Submit a church to the Charlotte directory. It is reviewed before it appears."
>
  {db ? (
    <div class="page wrap" style="max-width: 42rem">
      <h1>Add a church</h1>
      <p class="lede">This creates a review row. The church appears on the site only after it is approved. Include a page on the church website if you have one, so the listing can be checked the same way as the others.</p>
      {sent && <p class="notice notice-ok" role="status">Thanks. The submission is in the queue.</p>}
      {error === 'missing' && <p class="notice notice-error" role="alert">Add the church name, city, state, your email, and either a street address or a website.</p>}
      {error === 'save_failed' && <p class="notice notice-error" role="alert">That did not save. Try again in a moment.</p>}
      <form method="post" action="/api/submit" class="form-card">
        <label>Church name
          <input class="field" name="name" required maxlength="200" />
        </label>
        <label>Campus name, if it has one
          <input class="field" name="campus_name" maxlength="200" />
        </label>
        <label>Street address
          <input class="field" name="address" maxlength="300" />
        </label>
        <div class="filter-grid" style="margin-top: 0; padding: 0; border: 0; background: transparent">
          <label>City
            <input class="field" name="city" required maxlength="80" />
          </label>
          <label>State
            <input class="field" name="state" required maxlength="2" value="NC" />
          </label>
          <label>ZIP
            <input class="field" name="zip" maxlength="10" />
          </label>
        </div>
        <label>Phone
          <input class="field" name="phone" maxlength="40" />
        </label>
        <label>Website
          <input class="field" name="website" type="url" maxlength="300" placeholder="https://" />
        </label>
        <label>Service times, in the church’s words
          <textarea class="field" name="service_times" rows="3" maxlength="2000"></textarea>
        </label>
        <label>Languages
          <input class="field" name="languages_text" maxlength="200" placeholder="English; Spanish" />
        </label>
        <label>Church type
          <select class="field" name="denomination_family">
            <option value="">Not sure</option>
            {types.map((type) => <option value={type}>{type}</option>)}
          </select>
        </label>
        <label>Specific body, if you know it
          <input class="field" name="denomination_body" maxlength="200" placeholder="Southern Baptist Convention" />
        </label>
        <label>Anything else we should know
          <textarea class="field" name="note" rows="3" maxlength="1000"></textarea>
        </label>
        <label>Your name
          <input class="field" name="submitter_name" maxlength="120" />
        </label>
        <label>Your email
          <input class="field" name="submitter_email" type="email" required maxlength="200" />
        </label>
        <label class="sr-only" aria-hidden="true">Leave this blank
          <input name="company_fax" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn-primary" type="submit">Submit for review</button>
      </form>
    </div>
  ) : <DatabaseMissing />}
</Layout>
