---
import Layout from '../layouts/Layout.astro';
import ChurchCard from '../components/ChurchCard.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listAttributes, toSearchable } from '../lib/attributes';
import { listCities, listOpenChurches, unplacedChurches } from '../lib/queries';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const attributes = db ? await listAttributes(db) : { rows: [], ready: false };
const byId = new Map(attributes.rows.map((row) => [row.church_id, row]));
const typeOf = (id: string) => toSearchable(churches.find((church) => church.id === id)!, byId.get(id)).typeName;
const cities = db ? (await listCities(db)).filter((city) => city.church_count > 0) : [];
const unplaced = db ? await unplacedChurches(db) : [];
const preview = churches.filter((church) => church.city_id).slice(0, 12);
---

<Layout
  title="Charlotte metro"
  path="/charlotte"
  description="Churches in the Charlotte metro whose service times were checked against their own websites."
>
  {db ? (
    <div class="page wrap">
      <h1>Charlotte</h1>
      <p class="lede">
        The pilot covers Charlotte and nearby towns in this set: Matthews, Mint Hill, Huntersville, Cornelius, Davidson, and Pineville. {churches.length} churches are open in the directory.
      </p>
      <div class="chip-row">
        {cities.map((city) => (
          <a href={`/city/${city.slug}`} class="chip">{city.name} ({city.church_count})</a>
        ))}
      </div>
      <p style="margin-top: 1.25rem"><a href="/map" class="btn-secondary">Open the map</a></p>
      {unplaced.length > 0 && (
        <section class="section">
          <h2>City not on the listing yet</h2>
          <p class="quiet">These churches did not have a city in the source file. They stay in the directory.</p>
          <div class="card-grid" style="margin-top: 1rem">
            {unplaced.map((church) => (
              <ChurchCard slug={church.slug} name={church.name} familyName={typeOf(church.id)} city={church.city} state={church.state} sunday={church.earliest_sunday_time} languages={church.languages_text} serviceTimes={church.service_times} />
            ))}
          </div>
        </section>
      )}
      <div class="card-grid cols-3">
        {preview.map((church) => (
          <ChurchCard
            slug={church.slug}
            name={church.name}
            familyName={typeOf(church.id)}
            city={church.city}
            state={church.state}
            sunday={church.earliest_sunday_time}
            languages={church.languages_text}
            serviceTimes={church.service_times}
            photoKey={church.photo_key}
            historicallyBlack={Boolean(church.historically_black_tradition)}
          />
        ))}
      </div>
      <p class="quiet" style="margin-top: 1rem">Showing {preview.length} of {churches.length}. The map has every open church.</p>
    </div>
  ) : <DatabaseMissing />}
</Layout>
