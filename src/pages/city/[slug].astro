---
import Layout from '../../layouts/Layout.astro';
import ChurchCard from '../../components/ChurchCard.astro';
import DatabaseMissing from '../../components/DatabaseMissing.astro';
import { getDb } from '../../lib/db';
import { listAttributes, toSearchable } from '../../lib/attributes';
import { churchesInCity, getCity } from '../../lib/queries';

const db = getDb(Astro.locals);
const city = db ? await getCity(db, Astro.params.slug ?? '') : null;
if (db && !city) Astro.response.status = 404;
const churches = db && city ? await churchesInCity(db, city.id) : [];
const attributes = db ? await listAttributes(db) : { rows: [], ready: false };
const byId = new Map(attributes.rows.map((row) => [row.church_id, row]));
---

<Layout
  title={city ? `Churches in ${city.name}` : 'City'}
  path={`/city/${city?.slug ?? ''}`}
  description={city ? `Churches in ${city.name}, ${city.state}, with service times checked against their own websites.` : 'City'}
>
  {db ? (
    city ? (
      <div class="page wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/charlotte">Charlotte metro</a></nav>
        <h1 style="margin-top: 0.6rem">Churches in {city.name}, {city.state}</h1>
        <p class="lede">{churches.length} open {churches.length === 1 ? 'listing' : 'listings'}.</p>
        <p style="margin-top: 1rem"><a class="btn-secondary" href={`/map?place=${encodeURIComponent(city.name)}`}>See them on the map</a></p>
        {churches.length === 0 ? (
          <p class="notice">No open churches are listed in this town yet.</p>
        ) : (
          <div class="card-grid cols-3">
            {churches.map((church) => (
              <ChurchCard slug={church.slug} name={church.name} familyName={toSearchable(church, byId.get(church.id)).typeName} city={church.city} state={church.state} sunday={church.earliest_sunday_time} languages={church.languages_text} serviceTimes={church.service_times} photoKey={church.photo_key} historicallyBlack={Boolean(church.historically_black_tradition)} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="page wrap">
        <h1>That city is not in the pilot.</h1>
        <p class="lede"><a class="btn-secondary" href="/charlotte">Back to Charlotte</a></p>
      </div>
    )
  ) : <DatabaseMissing />}
</Layout>
