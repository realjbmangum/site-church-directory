---
import Layout from '../layouts/Layout.astro';
import BarList from '../components/BarList.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { futureFilterCounts, listIntents, listOpenChurches } from '../lib/queries';
import { TIME_BUCKETS, timeBucket } from '@shared/time';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const intents = db ? await listIntents(db) : [];
const future = db ? await futureFilterCounts(db) : null;

function countBy(key: (church: (typeof churches)[number]) => string) {
  const map = new Map<string, number>();
  for (const church of churches) {
    const label = key(church) || 'Not stated';
    map.set(label, (map.get(label) ?? 0) + 1);
  }
  return [...map.entries()]
    .map(([label, count]) => ({ label, count }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
}

const byFamily = countBy((church) => church.family_name || 'Not stated').map((row) => ({
  ...row,
  href: churches.find((church) => (church.family_name || 'Not stated') === row.label)?.family_slug
    ? `/denomination/${churches.find((church) => (church.family_name || 'Not stated') === row.label)?.family_slug}`
    : undefined,
}));
const byCity = countBy((church) => church.city || 'City not listed').map((row) => {
  const match = churches.find((church) => (church.city || 'City not listed') === row.label);
  return { ...row, href: match?.city_id ? `/city/${match.city_id}` : undefined };
});
const languageCounts = new Map<string, number>();
for (const church of churches) {
  const languages = (church.languages_text || 'Not listed').split(';').map((part) => part.trim()).filter(Boolean);
  for (const language of languages) languageCounts.set(language, (languageCounts.get(language) ?? 0) + 1);
}
const byLanguage = [...languageCounts.entries()].map(([label, count]) => ({ label, count, href: `/map?language=${encodeURIComponent(label)}` })).sort((a, b) => b.count - a.count);
const byTime = TIME_BUCKETS.map((bucket) => ({
  label: bucket.label,
  count: churches.filter((church) => timeBucket(church.earliest_sunday_minutes) === bucket.id).length,
  href: `/map?time=${bucket.id}`,
})).filter((row) => row.count > 0);

const tableRows = churches.map((church) => ({
  name: church.name,
  slug: church.slug,
  family: church.family_name || 'Not stated',
  body: church.body_name || 'Not stated',
  city: church.city || '',
  zip: church.zip || '',
  languages: church.languages_text || '',
  sunday: church.earliest_sunday_time || '',
  proof: church.proof_strength === 'strong' ? 'Strong' : church.proof_strength ? 'Needs another look' : 'Not checked',
}));
const familyOptions = [...new Set(tableRows.map((row) => row.family))].sort();
const cityOptions = [...new Set(tableRows.map((row) => row.city).filter(Boolean))].sort();
const futureRows = [
  ['Kids and youth', future?.kids_youth ?? 0],
  ['Worship style', future?.worship_style ?? 0],
  ['Theology', future?.theology ?? 0],
  ['Young adults', future?.young_adults ?? 0],
  ['LGBTQ stance', future?.lgbtq_stance ?? 0],
  ['Outreach', future?.outreach ?? 0],
] as const;
const liveFilters = new Set([1, 2, 5, 6]);
---

<Layout
  title="Charlotte church types"
  path="/analytics"
  description="How the Charlotte pilot breaks down by denomination family, city, language, and Sunday service time."
>
  {db ? (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <h1 class="font-serif text-4xl text-gray-900">What kinds of churches are here</h1>
      <p class="mt-3 max-w-2xl text-gray-700">Counts use the open listings in the Charlotte pilot. A church in more than one language is counted once for each language.</p>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <BarList title="Denomination family" rows={byFamily} />
        <BarList title="City" rows={byCity} />
        <BarList title="Language" rows={byLanguage} />
        <BarList title="Earliest Sunday service" rows={byTime} />
      </div>

      <section class="mt-10 card p-5">
        <div class="flex flex-wrap gap-3 items-end">
          <h2 class="font-serif text-2xl flex-1">Every open church</h2>
          <p id="table-count" class="text-sm text-gray-600">{churches.length} churches</p>
        </div>
        <div class="mt-4 grid gap-3 md:grid-cols-3">
          <input id="table-filter" class="field" placeholder="Filter this table" />
          <select id="table-family" class="field">
            <option value="">Any family</option>
            {familyOptions.map((name) => <option value={name}>{name}</option>)}
          </select>
          <select id="table-city" class="field">
            <option value="">Any city</option>
            {cityOptions.map((name) => <option value={name}>{name}</option>)}
          </select>
        </div>
        <div class="mt-4 overflow-x-auto">
          <table id="church-table" class="w-full text-sm text-left">
            <thead class="text-gray-600">
              <tr>
                {[['name','Church'],['family','Family'],['body','Body'],['city','City'],['zip','ZIP'],['languages','Languages'],['sunday','Sunday'],['proof','Proof']].map(([key, label]) => (
                  <th class="px-3 py-2 font-medium"><button type="button" data-sort={key} class="hover:text-primary-700">{label}</button></th>
                ))}
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <script id="table-data" type="application/json" set:html={JSON.stringify(tableRows).replace(/</g, '\\u003c')}></script>
        <script>
          import { mountTable } from '../scripts/analytics-table';
          const rows = JSON.parse(document.getElementById('table-data')?.textContent || '[]');
          const table = document.getElementById('church-table');
          if (table instanceof HTMLTableElement) mountTable(table, rows);
        </script>
      </section>

      <section class="mt-10 card p-5">
        <h2 class="font-serif text-2xl">Saved for later</h2>
        <p class="mt-2 text-gray-700">These columns exist so we can filter on them later. They are empty until a church states the fact on its own site. We do not guess.</p>
        <ul class="mt-4 grid sm:grid-cols-2 gap-2 text-sm">
          {futureRows.map(([label, count]) => (
            <li class="bg-cream-100 rounded-lg px-3 py-2 flex justify-between"><span>{label}</span><span>{count} filled in</span></li>
          ))}
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="font-serif text-2xl">What people search for</h2>
        <p class="mt-2 text-gray-600 max-w-2xl">Ranks come from the research file that shipped with the pilot. A live filter is on the map today. The rest wait on source text from the church.</p>
        <div class="mt-4 overflow-x-auto card">
          <table class="w-full text-sm">
            <thead class="text-left text-gray-600">
              <tr><th class="px-3 py-2">Rank</th><th class="px-3 py-2">Category</th><th class="px-3 py-2">In this pilot</th></tr>
            </thead>
            <tbody>
              {intents.map((intent) => (
                <tr class="border-t border-cream-200">
                  <td class="px-3 py-2 tabular-nums">{intent.rank}</td>
                  <td class="px-3 py-2">{intent.category}</td>
                  <td class="px-3 py-2">{liveFilters.has(intent.rank) ? 'On the map' : intent.recommendation === 'Skip' || (intent.recommendation || '').startsWith('Skip') ? 'Not a filter' : 'Column ready, not filled in'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  ) : <DatabaseMissing />}
</Layout>
