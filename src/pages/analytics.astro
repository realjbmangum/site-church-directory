---
import Layout from '../layouts/Layout.astro';
import BarList from '../components/BarList.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listAttributes, toSearchable } from '../lib/attributes';
import { listIntents, listOpenChurches } from '../lib/queries';
import { churchTypeSlug } from '@shared/church-types';
import { TIME_BUCKETS, timeBucket } from '@shared/time';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const intents = db ? await listIntents(db) : [];
const attributes = db ? await listAttributes(db) : { rows: [], ready: false };
const byId = new Map(attributes.rows.map((row) => [row.church_id, row]));
const facts = churches.map((church) => ({ church, search: toSearchable(church, byId.get(church.id)) }));

function countBy(key: (row: (typeof facts)[number]) => string) {
  const map = new Map<string, number>();
  for (const row of facts) {
    const label = key(row) || 'Not stated';
    map.set(label, (map.get(label) ?? 0) + 1);
  }
  return [...map.entries()]
    .map(([label, count]) => ({ label, count }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
}

const byType = countBy((row) => row.search.typeName).map((row) => ({
  ...row,
  href: `/denomination/${churchTypeSlug(row.label)}`,
}));
const byCity = countBy((row) => row.church.city || 'City not listed').map((row) => {
  const match = facts.find((item) => (item.church.city || 'City not listed') === row.label);
  return { ...row, href: match?.church.city_id ? `/city/${match.church.city_id}` : undefined };
});
const languageCounts = new Map<string, number>();
for (const row of facts) {
  const languages = row.search.languages.length ? row.search.languages : ['Not listed'];
  for (const language of languages) languageCounts.set(language, (languageCounts.get(language) ?? 0) + 1);
}
const byLanguage = [...languageCounts.entries()].map(([label, count]) => ({
  label,
  count,
  href: label === 'Not listed' ? undefined : `/map?language=${encodeURIComponent(label)}`,
})).sort((a, b) => b.count - a.count);
const byTime = TIME_BUCKETS.map((bucket) => ({
  label: bucket.label,
  count: facts.filter((row) => timeBucket(row.church.earliest_sunday_minutes) === bucket.id).length,
  href: bucket.id === 'not-listed' ? undefined : `/map?time=${bucket.id}`,
})).filter((row) => row.count > 0);
const stated = [
  ['Kids ministry', facts.filter((row) => row.search.kids).length, '/map?kids=1'],
  ['Youth group', facts.filter((row) => row.search.youth).length, '/map?youth=1'],
  ['Nursery', facts.filter((row) => row.search.nursery).length, '/map?nursery=1'],
  ['Young adults', facts.filter((row) => row.search.youngAdults).length, '/map?young=1'],
  ['Choir', facts.filter((row) => row.search.choir).length, '/map?choir=1'],
  ['Livestream', facts.filter((row) => row.search.livestream).length, '/map?live=1'],
  ['Small groups or Bible study', facts.filter((row) => row.search.groups).length, '/map?groups=1'],
  ['School or preschool', facts.filter((row) => row.search.school).length, '/map?school=1'],
].map(([label, count, href]) => ({ label: String(label), count: Number(count), href: String(href) }));
const worshipLabels: Record<string, string> = { traditional: 'Traditional', contemporary: 'Contemporary', liturgical: 'Liturgical', blended: 'Blended', gospel: 'Gospel', charismatic: 'Charismatic' };
const outreachLabels: Record<string, string> = { 'community-service': 'Community service', missions: 'Missions', 'food-pantry': 'Food pantry', grief: 'Grief and care', recovery: 'Recovery', esl: 'ESL' };
function tokenRows(pick: (row: (typeof facts)[number]) => string[], labels: Record<string, string>, param: string) {
  const counts = new Map<string, number>();
  for (const row of facts) {
    for (const token of pick(row)) counts.set(token, (counts.get(token) ?? 0) + 1);
  }
  return [...counts.entries()]
    .map(([token, count]) => ({ label: labels[token] || token, count, href: `/map?${param}=${encodeURIComponent(token)}` }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
}
const byWorship = tokenRows((row) => row.search.worship, worshipLabels, 'worship');
const byOutreach = tokenRows((row) => row.search.outreach, outreachLabels, 'outreach');

const tableRows = facts.map(({ church, search }) => ({
  name: church.name,
  slug: church.slug,
  type: search.typeName,
  city: church.city || '',
  zip: church.zip || '',
  languages: church.languages_text || '',
  sunday: church.earliest_sunday_time || '',
  worship: search.worship.join(', '),
  outreach: search.outreach.join(', '),
}));
const typeOptions = [...new Set(tableRows.map((row) => row.type))].sort();
const cityOptions = [...new Set(tableRows.map((row) => row.city).filter(Boolean))].sort();
const liveRanks = new Set([1, 2, 3, 4, 5, 6, 8, 9, 12, 13]);
const columns = [['name','Church'],['type','Church type'],['city','City'],['zip','ZIP'],['languages','Languages'],['sunday','Sunday'],['worship','Worship'],['outreach','Outreach']] as const;
---

<Layout
  title="Charlotte church types"
  path="/analytics"
  description="How the Charlotte pilot breaks down by church type, city, language, service time, and what churches state on their own sites."
>
  {db ? (
    <div class="page wrap">
      <h1>What kinds of churches are here</h1>
      <p class="lede">Counts use the open listings in the Charlotte pilot. A ministry count means the church stated it on its own site. A missing fact is not a no.</p>
      {!attributes.ready && <p class="notice">The researched filters are not loaded in this database yet. Church type still comes from the existing listing. Ministry counts stay at zero until that seed is applied.</p>}
      <div class="chart-grid" style="margin-top: 1.75rem">
        <BarList title="Church type" rows={byType} />
        <BarList title="City" rows={byCity} />
        <BarList title="Language" rows={byLanguage} />
        <BarList title="Earliest Sunday service" rows={byTime} />
        <BarList title="Stated on the church site" rows={stated} />
        <BarList title="Worship style" rows={byWorship} />
        <BarList title="Outreach" rows={byOutreach} />
      </div>

      <section class="section panel">
        <div class="section-head">
          <h2>Every open church</h2>
          <p id="table-count" class="count-line">{churches.length} churches</p>
        </div>
        <div class="filter-grid" style="margin-top: 1rem">
          <label>Filter this table
            <input id="table-filter" class="field" placeholder="Name, language, city" />
          </label>
          <label>Church type
            <select id="table-family" class="field">
              <option value="">Any type</option>
              {typeOptions.map((name) => <option value={name}>{name}</option>)}
            </select>
          </label>
          <label>City
            <select id="table-city" class="field">
              <option value="">Any city</option>
              {cityOptions.map((name) => <option value={name}>{name}</option>)}
            </select>
          </label>
        </div>
        <div class="table-scroll">
          <table id="church-table" class="data-table">
            <thead>
              <tr>
                {columns.map(([key, label]) => (
                  <th scope="col"><button type="button" data-sort={key} aria-label={`Sort by ${label}`}>{label}</button></th>
                ))}
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <script id="table-data" type="application/json" set:html={JSON.stringify(tableRows).replace(/</g, '\\u003c')}></script>
        <script>
          import { mountTable } from '../scripts/analytics-table';
          const rows = JSON.parse(document.getElementById('table-data')?.textContent || '[]');
          const table = document.getElementById('church-table');
          if (table instanceof HTMLTableElement) mountTable(table, rows);
        </script>
      </section>

      <section class="section">
        <h2>What people search for</h2>
        <p class="quiet" style="margin-top: 0.4rem; max-width: 68ch">Ranks come from the research file that shipped with the pilot. A live filter is on the map today when the church's own site states the fact.</p>
        <div class="table-scroll panel" style="padding: 0.25rem 0.4rem">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Rank</th>
                <th scope="col">Category</th>
                <th scope="col">In this pilot</th>
              </tr>
            </thead>
            <tbody>
              {intents.map((intent) => (
                <tr>
                  <td class="tabular-nums">{intent.rank}</td>
                  <td>{intent.category}</td>
                  <td>{liveRanks.has(intent.rank) ? 'On the map' : intent.recommendation === 'Skip' || (intent.recommendation || '').startsWith('Skip') ? 'Not a filter' : 'On the church page when the site says so'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  ) : <DatabaseMissing />}
</Layout>
