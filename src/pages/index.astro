---
import Layout from '../layouts/Layout.astro';
import ChurchCard from '../components/ChurchCard.astro';
import { getDirectory, formatLongDate } from '../lib/load';

const directory = getDirectory();
const churches = directory.churches.filter((church) => church.published);
const families = directory.families.filter((family) => family.churchCount > 0);
const checked = formatLongDate(directory.checkedOn);
const site = Astro.site?.toString().replace(/\/$/, '') || '';

const spotlight = families.slice(0, 6).map((family) =>
  churches.find((church) => church.familySlug === family.slug),
).filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Find a Church',
  url: site || undefined,
  description: 'Charlotte church directory. Listings are checked against church websites.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site}/map?place={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout title="Home" description="Find a church in Charlotte. Search verified listings by denomination, city, language, and service time." jsonLd={jsonLd}>
  <section class="bg-cream-50 border-b border-cream-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
      <p class="badge mb-4">Charlotte pilot</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 max-w-3xl">Find a church in Charlotte</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl">
        {directory.counts.churches} churches, checked against their own websites{checked ? ` on ${checked}` : ''}. Search by denomination, language, city or ZIP, and service time.
      </p>
      <form action="/map" method="get" class="mt-8 card p-4 sm:p-5 grid gap-3 sm:grid-cols-12">
        <div class="sm:col-span-5">
          <label for="place" class="block text-sm font-medium text-gray-700 mb-1">City or ZIP</label>
          <input id="place" name="place" class="field" placeholder="Charlotte or 28205" />
        </div>
        <div class="sm:col-span-4">
          <label for="family" class="block text-sm font-medium text-gray-700 mb-1">Denomination</label>
          <select id="family" name="family" class="field">
            <option value="">Any family</option>
            {families.map((family) => (
              <option value={family.slug}>{family.name}</option>
            ))}
          </select>
        </div>
        <div class="sm:col-span-3 flex items-end">
          <button class="btn-primary w-full" type="submit">Search the map</button>
        </div>
      </form>
      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <a class="btn-quiet" href="/charlotte">Charlotte metro</a>
        <a class="btn-quiet" href="/map?language=Spanish">Spanish services</a>
        <a class="btn-quiet" href="/map?time=saturday">Saturday services</a>
        <a class="btn-quiet" href="/analytics">Charts for this area</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        [directory.counts.churches, 'Churches checked'],
        [directory.counts.families, 'Denomination families'],
        [directory.counts.cities, 'Cities and towns'],
        [directory.counts.nonEnglish, 'With a service besides English'],
      ].map(([count, label]) => (
        <div class="card p-5">
          <dt class="text-sm text-gray-600">{label}</dt>
          <dd class="mt-1 font-serif text-3xl text-gray-900">{count}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-12">
    <div class="flex items-end justify-between gap-4 mb-5">
      <h2 class="font-serif text-3xl">Browse by denomination</h2>
      <a class="text-sm text-primary-700 hover:text-primary-800" href="/denominations">All families</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {families.map((family) => (
        <a class="card p-5 block hover:bg-cream-50" href={`/denominations/${family.slug}`}>
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-serif text-xl">{family.name}</h3>
            <span class="text-sm text-gray-500">{family.churchCount}</span>
          </div>
          <p class="mt-2 text-sm text-gray-600">{family.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-12">
    <div class="flex items-end justify-between gap-4 mb-5">
      <h2 class="font-serif text-3xl">A church from each larger family</h2>
      <a class="text-sm text-primary-700 hover:text-primary-800" href="/churches">All churches</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {spotlight.map((church) => church && <ChurchCard church={church} />)}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-4">
    <div class="callout sm:flex sm:items-center sm:justify-between gap-6">
      <div>
        <h2 class="font-serif text-2xl">Is your church missing?</h2>
        <p class="mt-2 text-gray-600 max-w-xl">Send the details. It waits for review and is not added to the public list until someone approves it.</p>
      </div>
      <a class="btn-primary mt-4 sm:mt-0 shrink-0" href="/submit">Submit a church</a>
    </div>
  </section>
</Layout>
