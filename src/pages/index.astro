---
import Layout from '../layouts/Layout.astro';
import ScenicPhoto from '../components/ScenicPhoto.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listCities, listFamilies, listLanguages, listOpenChurches } from '../lib/queries';
import { formatChecked, placeLine, serviceLines, snippet } from '../lib/format';
import { TIME_BUCKETS, timeBucket } from '@shared/time';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const families = db ? (await listFamilies(db)).filter((family) => family.church_count > 0) : [];
const cities = db ? (await listCities(db)).filter((city) => city.church_count > 0) : [];
const languages = db ? (await listLanguages(db)).filter((language) => language.language !== 'English') : [];

const byTime = churches
  .filter((church) => church.earliest_sunday_minutes != null && church.earliest_sunday_time)
  .sort((a, b) => (a.earliest_sunday_minutes ?? 0) - (b.earliest_sunday_minutes ?? 0) || a.name.localeCompare(b.name));
const featured = byTime[0] ?? churches[0];
const board = byTime.filter((church) => church.slug !== featured?.slug).slice(0, 3);
const checked = featured ? formatChecked(featured.date_checked) : null;

function serviceInset(raw: string | null | undefined): string {
  const lines = serviceLines(raw);
  if (lines) return lines.join(' | ');
  const clean = (raw ?? '').replace(/\s+/g, ' ').trim();
  return clean ? snippet(clean, 180) : 'Not listed on the page we checked.';
}

const buckets = TIME_BUCKETS.map((bucket) => ({
  ...bucket,
  count: churches.filter((church) => timeBucket(church.earliest_sunday_minutes) === bucket.id).length,
})).filter((bucket) => bucket.count > 0);
---

<Layout
  title="Home"
  path="/"
  description="Find a church in Charlotte. Browse verified listings by denomination, language, city, and Sunday service time."
>
  {db ? (
    <>
      <section class="hero">
        <ScenicPhoto variant="hero" />
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <h1>Find a Sunday service you can check.</h1>
            <p class="lede">
              {churches.length} churches in Charlotte and nearby towns. Each listing keeps a line from the church’s own site, a link to that page, and the date we checked it.
            </p>
            <form action="/map" method="get" class="search-card">
              <label>
                Name, city, or ZIP
                <input class="field" type="search" name="q" autocomplete="off" />
              </label>
              <label>
                Denomination family
                <select class="field" name="family">
                  <option value="">Any family</option>
                  {families.map((family) => <option value={family.slug}>{family.name}</option>)}
                </select>
              </label>
              <button class="btn-secondary" type="submit">Search the map</button>
            </form>
          </div>
          {featured && (
            <article class="proof-panel">
              <h2 class="proof-time">{featured.earliest_sunday_time || 'Time not listed'}</h2>
              <p class="time-caption">Earliest Sunday service</p>
              <p class="proof-name"><a href={`/church/${featured.slug}`}>{featured.name}</a></p>
              <p class="meta">{[placeLine(featured), featured.family_name].filter(Boolean).join(' · ')}</p>
              <p class="times-inset">
                <span class="inset-label">Service times</span>
                <span aria-hidden="true"> | </span>
                {serviceInset(featured.service_times)}
              </p>
              <p class="meta checked-line">
                {checked ? `Last checked ${checked}.` : 'Checked against the church website.'}
              </p>
              <p><a class="btn-secondary" href={`/church/${featured.slug}`}>Open the listing</a></p>
            </article>
          )}
        </div>

        {board.length > 0 && (
          <div class="more-block">
            <div class="wrap">
              <div class="section-head on-photo">
                <h2>More Sunday times</h2>
                <a href="/map">See all on the map</a>
              </div>
              <div class="time-row">
                {board.map((church) => (
                  <a class="time-card" href={`/church/${church.slug}`}>
                    <span class="time-card-time">{church.earliest_sunday_time}</span>
                    <span class="time-card-name">{church.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )}
      </section>

      <div class="page-rest">
        {languages.length > 0 && (
          <section class="section wrap">
            <h2>Services in another language</h2>
            <p class="quiet">A church can appear under more than one language. English is the default on most listings.</p>
            <div class="chip-row">
              {languages.map((language) => (
                <a class="chip" href={`/map?language=${encodeURIComponent(language.language)}`}>
                  {language.language} ({language.church_count})
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="section wrap">
          <h2>Browse by denomination family</h2>
          <p class="quiet">Family is the broad tradition. The church page also names the specific body when we know it.</p>
          <ul class="legend legend-split">
            {families.map((family) => (
              <li>
                <a href={`/denomination/${family.slug}`}>
                  <span>{family.name}</span>
                  <span class="legend-meta">{family.church_count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="section wrap split">
          <div>
            <h2>Towns in the pilot</h2>
            <ul class="legend">
              {cities.map((city) => (
                <li>
                  <a href={`/city/${city.slug}`}>
                    <span>{city.name}</span>
                    <span class="legend-meta">{city.church_count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2>Sunday start times we could read</h2>
            <ul class="legend">
              {buckets.map((bucket) => (
                <li>
                  <a href={`/map?time=${bucket.id}`}>
                    <span>{bucket.label}</span>
                    <span class="legend-meta">{bucket.count}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="quiet" style="margin-top: 0.9rem">Times come from the church site. When a page did not state a clear Sunday start, the listing says so.</p>
          </div>
        </section>
      </div>
    </>
  ) : <DatabaseMissing />}
</Layout>
