---
import Layout from '../layouts/Layout.astro';
import ChurchCard from '../components/ChurchCard.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listCities, listFamilies, listOpenChurches } from '../lib/queries';
import { TIME_BUCKETS, timeBucket } from '@shared/time';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const families = db ? (await listFamilies(db)).filter((family) => family.church_count > 0) : [];
const cities = db ? (await listCities(db)).filter((city) => city.church_count > 0) : [];
const withProof = churches.filter((church) => church.proof_url).length;
const buckets = TIME_BUCKETS.map((bucket) => ({
  ...bucket,
  count: churches.filter((church) => timeBucket(church.earliest_sunday_minutes) === bucket.id).length,
})).filter((bucket) => bucket.count > 0);
---

<Layout
  title="Home"
  path="/"
  description="Find a church in Charlotte. Browse verified listings by denomination, language, city, and Sunday service time."
>
  {db ? (
    <>
      <section class="bg-cream-50 border-b border-cream-300">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-700">Charlotte pilot</p>
          <h1 class="mt-3 font-serif text-4xl md:text-5xl text-gray-900 max-w-3xl">Find a church whose service time you can check.</h1>
          <p class="mt-4 max-w-2xl text-lg text-gray-700">
            This directory lists churches in Charlotte and nearby towns. Each one includes a short quote from the church’s own website, a link to that page, and the date we checked it.
          </p>
          <form action="/map" method="get" class="mt-8 card p-4 grid gap-3 md:grid-cols-[1fr_14rem_auto] md:items-end">
            <label class="block">
              <span class="text-sm font-medium text-gray-800">Name, city, or ZIP</span>
              <input class="field mt-1" type="search" name="q" placeholder="Matthews, 28205, Baptist" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-gray-800">Denomination family</span>
              <select class="field mt-1" name="family">
                <option value="">Any family</option>
                {families.map((family) => <option value={family.slug}>{family.name}</option>)}
              </select>
            </label>
            <button class="btn-primary" type="submit">Search the map</button>
          </form>
          <dl class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="card px-4 py-3"><dt class="text-sm text-gray-600">Open churches</dt><dd class="font-serif text-3xl">{churches.length}</dd></div>
            <div class="card px-4 py-3"><dt class="text-sm text-gray-600">With a source link</dt><dd class="font-serif text-3xl">{withProof}</dd></div>
            <div class="card px-4 py-3"><dt class="text-sm text-gray-600">Families with a church</dt><dd class="font-serif text-3xl">{families.length}</dd></div>
            <div class="card px-4 py-3"><dt class="text-sm text-gray-600">Towns</dt><dd class="font-serif text-3xl">{cities.length}</dd></div>
          </dl>
        </div>
      </section>

      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
        <div class="flex items-end justify-between gap-4 mb-6">
          <h2 class="font-serif text-3xl text-gray-900">A few churches</h2>
          <a href="/map" class="text-sm font-semibold text-primary-700">See all on the map</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {churches.slice(0, 6).map((church) => (
            <ChurchCard
              slug={church.slug}
              name={church.name}
              familyName={church.family_name}
              bodyName={church.body_name}
              city={church.city}
              state={church.state}
              serviceTimes={church.service_times}
              sunday={church.earliest_sunday_time}
              languages={church.languages_text}
              photoKey={church.photo_key}
              historicallyBlack={Boolean(church.historically_black_tradition)}
            />
          ))}
        </div>
      </section>

      <section class="bg-white border-y border-cream-300">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
          <h2 class="font-serif text-3xl text-gray-900">Browse by denomination family</h2>
          <p class="mt-2 text-gray-600 max-w-2xl">Family is the broad tradition. The church page also names the specific body when we know it.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {families.map((family) => (
              <a href={`/denomination/${family.slug}`} class="card p-4 hover:border-primary-300">
                <p class="font-serif text-xl text-gray-900">{family.name}</p>
                <p class="text-sm text-gray-600 mt-1">{family.church_count} {family.church_count === 1 ? 'church' : 'churches'}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14 grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-serif text-3xl text-gray-900">Towns in the pilot</h2>
          <ul class="mt-4 grid grid-cols-2 gap-3">
            {cities.map((city) => (
              <li>
                <a href={`/city/${city.slug}`} class="card block px-4 py-3 hover:border-primary-300">
                  <span class="font-medium text-gray-900">{city.name}</span>
                  <span class="block text-sm text-gray-600">{city.church_count} churches</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="card p-6 bg-cream-50">
          <h2 class="font-serif text-2xl text-gray-900">Sunday start times we could read</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {buckets.map((bucket) => (
              <li class="flex justify-between gap-4 bg-white rounded-lg px-3 py-2 border border-cream-300">
                <a href={`/map?time=${bucket.id}`} class="hover:text-primary-700">{bucket.label}</a>
                <span class="tabular-nums text-gray-600">{bucket.count}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-gray-600">Times come from the church site. When a page did not state a clear Sunday start, the listing says so.</p>
        </div>
      </section>
    </>
  ) : <DatabaseMissing />}
</Layout>
