---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" path="/404" noindex={true} description="That page is not in the church directory.">
  <div class="max-w-xl mx-auto px-4 py-20">
    <h1 class="font-serif text-4xl text-gray-900">That page is not here.</h1>
    <p class="mt-3 text-gray-700">Try the map, or start from the Charlotte metro page.</p>
    <p class="mt-4 flex gap-3">
      <a class="btn-primary" href="/map">Map</a>
      <a class="btn-secondary" href="/charlotte">Charlotte</a>
    </p>
  </div>
</Layout>
