---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="That page is not in the Charlotte church directory." noindex>
  <div class="max-w-xl mx-auto px-4 py-20 text-center">
    <h1 class="font-serif text-4xl">Page not found</h1>
    <p class="mt-3 text-gray-600">That address is not in this pilot.</p>
    <p class="mt-6"><a class="btn-primary" href="/">Back to the directory</a></p>
  </div>
</Layout>
