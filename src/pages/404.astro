---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" path="/404" noindex={true} description="That page is not in the church directory.">
  <div class="page wrap">
    <h1>That page is not here.</h1>
    <p class="lede">Try the map, or start from the Charlotte metro page.</p>
    <p class="chip-row">
      <a class="btn-primary" href="/map">Map</a>
      <a class="btn-secondary" href="/charlotte">Charlotte</a>
    </p>
  </div>
</Layout>
