---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getDirectory, SERVICE_BUCKETS, serviceBucket } from '../lib/load';

const directory = getDirectory();
const churches = directory.churches.filter((church) => church.published);
const families = directory.families.filter((family) => family.churchCount > 0);
const languages = [...new Set(churches.flatMap((church) => church.languages))].sort();
const points = churches.map((church) => ({
  slug: church.slug,
  name: church.name,
  city: church.city,
  state: church.state,
  postalCode: church.postalCode,
  familySlug: church.familySlug,
  familyName: church.familyName,
  bodySlug: church.bodySlug,
  bodyName: church.bodyName,
  languages: church.languages,
  latitude: church.latitude,
  longitude: church.longitude,
  earliestSundayTime: church.earliestSundayTime,
  earliestSundayMinutes: church.earliestSundayMinutes,
  serviceTimesText: church.serviceTimesText,
  bucket: serviceBucket(church),
}));
const payload = JSON.stringify({ points, bodies: directory.bodies.filter((body) => body.churchCount > 0).map((body) => ({
  slug: body.slug,
  name: body.name,
  familySlug: body.familySlug,
})) }).replace(/</g, '\\u003c');
---

<Layout
  title="Map"
  description="Map of Charlotte churches. Filter by denomination family, specific body, language, city or ZIP, and service time."
>
  <PageHeader
    title="Map"
    lede="Denomination family is the first filter. The specific body narrows that family. Language, city or ZIP, and service time narrow it further."
    crumbs={[{ label: 'Map' }]}
  />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <form id="map-filters" class="card p-4 grid gap-3 md:grid-cols-2 lg:grid-cols-6 mb-4">
      <label class="block text-sm lg:col-span-2">
        <span class="text-gray-700">City or ZIP</span>
        <input name="place" class="field mt-1" placeholder="Huntersville or 28078" />
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Family</span>
        <select name="family" class="field mt-1">
          <option value="">Any family</option>
          {families.map((family) => <option value={family.slug}>{family.name}</option>)}
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Body</span>
        <select name="body" class="field mt-1">
          <option value="">Any body</option>
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Language</span>
        <select name="language" class="field mt-1">
          <option value="">Any language</option>
          {languages.map((language) => <option value={language}>{language}</option>)}
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Service time</span>
        <select name="time" class="field mt-1">
          <option value="">Any time</option>
          {SERVICE_BUCKETS.filter((bucket) => bucket.id !== 'unknown').map((bucket) => (
            <option value={bucket.id}>{bucket.label}</option>
          ))}
          <option value="saturday">Saturday service</option>
        </select>
      </label>
    </form>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <p id="map-count" class="text-sm text-gray-600">{churches.length} churches</p>
      <button id="map-reset" class="btn-quiet text-sm" type="button">Reset filters</button>
    </div>
    <div class="grid lg:grid-cols-5 gap-4">
      <div class="lg:col-span-3 card overflow-hidden">
        <div id="church-map" class="map-frame"></div>
      </div>
      <div class="lg:col-span-2 card overflow-hidden">
        <ul id="map-list" class="max-h-[32rem] lg:max-h-[40rem] overflow-y-auto divide-y divide-cream-200"></ul>
      </div>
    </div>
    <p class="mt-3 text-xs text-gray-500">Map tiles © OpenStreetMap contributors. {directory.counts.geocoded} of {directory.counts.churches} churches have coordinates.</p>
  </div>
  <script id="map-data" type="application/json" set:html={payload}></script>
</Layout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Point = {
    slug: string;
    name: string;
    city: string | null;
    state: string | null;
    postalCode: string | null;
    familySlug: string;
    familyName: string;
    bodySlug: string;
    bodyName: string;
    languages: string[];
    latitude: number | null;
    longitude: number | null;
    earliestSundayTime: string | null;
    serviceTimesText: string;
    bucket: string;
  };

  const data = JSON.parse(document.querySelector('#map-data')?.textContent || '{"points":[],"bodies":[]}');
  const points = data.points as Point[];
  const bodies = data.bodies as { slug: string; name: string; familySlug: string }[];
  const form = document.querySelector<HTMLFormElement>('#map-filters');
  const list = document.querySelector<HTMLUListElement>('#map-list');
  const count = document.querySelector('#map-count');
  const mapEl = document.querySelector<HTMLElement>('#church-map');
  if (!form || !list || !mapEl) throw new Error('map markup missing');

  const map = L.map(mapEl, { scrollWheelZoom: true }).setView([35.2271, -80.8431], 10);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);
  const layer = L.layerGroup().addTo(map);

  function esc(value: string) {
    return value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char));
  }

  function readFilters() {
    const formData = new FormData(form!);
    return {
      place: String(formData.get('place') || '').trim().toLowerCase(),
      family: String(formData.get('family') || ''),
      body: String(formData.get('body') || ''),
      language: String(formData.get('language') || ''),
      time: String(formData.get('time') || ''),
    };
  }

  function matches(point: Point, filters: ReturnType<typeof readFilters>) {
    if (filters.family && point.familySlug !== filters.family) return false;
    if (filters.body && point.bodySlug !== filters.body) return false;
    if (filters.language && !point.languages.some((language) => language.toLowerCase() === filters.language.toLowerCase())) return false;
    if (filters.place) {
      const haystack = `${point.city || ''} ${point.postalCode || ''}`.toLowerCase();
      if (!haystack.includes(filters.place)) return false;
    }
    if (filters.time === 'saturday') {
      if (!/saturday/i.test(point.serviceTimesText || '')) return false;
    } else if (filters.time && point.bucket !== filters.time) return false;
    return true;
  }

  function syncBodies() {
    const family = String(new FormData(form!).get('family') || '');
    const select = form!.querySelector<HTMLSelectElement>('[name="body"]');
    if (!select) return;
    const current = select.value;
    select.innerHTML = '<option value="">Any body</option>';
    for (const body of bodies) {
      if (family && body.familySlug !== family) continue;
      const option = document.createElement('option');
      option.value = body.slug;
      option.textContent = body.name;
      select.append(option);
    }
    if ([...select.options].some((option) => option.value === current)) select.value = current;
  }

  function render() {
    const filters = readFilters();
    const shown = points.filter((point) => matches(point, filters));
    layer.clearLayers();
    list!.replaceChildren();
    const bounds: L.LatLngExpression[] = [];
    for (const point of shown) {
      const place = [point.city, point.state].filter(Boolean).join(', ');
      const when = point.earliestSundayTime ? `Sunday ${point.earliestSundayTime}` : 'Service time listed on the church page';
      const item = document.createElement('li');
      item.innerHTML = `<a class="block px-4 py-3 hover:bg-cream-50" href="/churches/${esc(point.slug)}"><span class="font-medium text-gray-900">${esc(point.name)}</span><span class="block text-sm text-gray-600">${esc(point.familyName)} · ${esc(place || 'City not listed')}</span><span class="block text-sm text-gray-600">${esc(when)}</span></a>`;
      list!.append(item);
      if (point.latitude != null && point.longitude != null) {
        const marker = L.circleMarker([point.latitude, point.longitude], {
          radius: 8,
          color: '#9a4c33',
          weight: 2,
          fillColor: '#c97652',
          fillOpacity: 0.92,
        });
        marker.bindPopup(`<strong>${esc(point.name)}</strong><br>${esc(point.familyName)}<br><a href="/churches/${esc(point.slug)}">View church</a>`);
        marker.addTo(layer);
        bounds.push([point.latitude, point.longitude]);
      }
    }
    const unmapped = shown.filter((point) => point.latitude == null || point.longitude == null).length;
    if (count) {
      count.textContent = unmapped
        ? `${shown.length} churches, ${unmapped} without a map point`
        : `${shown.length} churches`;
    }
    if (bounds.length > 1) map.fitBounds(bounds, { padding: [28, 28], maxZoom: 13 });
    else if (bounds.length === 1) map.setView(bounds[0], 13);
    else map.setView([35.2271, -80.8431], 10);
  }

  const params = new URLSearchParams(location.search);
  for (const key of ['place', 'family', 'language', 'time', 'body']) {
    const field = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${key}"]`);
    const value = params.get(key);
    if (field && value) field.value = value;
  }
  syncBodies();
  if (params.get('body')) {
    const select = form.querySelector<HTMLSelectElement>('[name="body"]');
    if (select) select.value = params.get('body') || '';
  }
  form.addEventListener('input', () => {
    if ((document.activeElement as HTMLSelectElement | null)?.name === 'family') syncBodies();
    render();
  });
  form.addEventListener('submit', (event) => event.preventDefault());
  form.querySelector('[name="family"]')?.addEventListener('change', () => {
    syncBodies();
    render();
  });
  document.querySelector('#map-reset')?.addEventListener('click', () => {
    form.reset();
    syncBodies();
    render();
  });
  render();
  requestAnimationFrame(() => map.invalidateSize());
</script>
