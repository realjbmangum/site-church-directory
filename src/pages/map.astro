---
import Layout from '../layouts/Layout.astro';
import FilterGroups from '../components/FilterGroups.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listAttributes, toSearchable } from '../lib/attributes';
import { listOpenChurches } from '../lib/queries';
import { churchTypeSlug } from '@shared/church-types';
import { CHURCH_TYPE_ORDER } from '@shared/church-type-data';
import { filterGroups, matchesSearch, readSearchFilters } from '@shared/filters';
import 'leaflet/dist/leaflet.css';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const attributes = db ? await listAttributes(db) : { rows: [], ready: false };
const byId = new Map(attributes.rows.map((row) => [row.church_id, row]));
const searchable = churches.map((church) => {
  const facts = toSearchable(church, byId.get(church.id));
  return {
    ...facts,
    lat: church.latitude,
    lng: church.longitude,
    sunday: church.earliest_sunday_time ?? '',
    address: church.address ?? '',
  };
});
const filters = readSearchFilters(Astro.url.searchParams);
const visibleCount = searchable.filter((church) => matchesSearch(church, filters)).length;
const typeCounts = new Map<string, number>();
for (const church of searchable) typeCounts.set(church.typeSlug, (typeCounts.get(church.typeSlug) ?? 0) + 1);
const types = CHURCH_TYPE_ORDER.map((name) => ({ name, slug: churchTypeSlug(name), count: typeCounts.get(churchTypeSlug(name)) ?? 0 })).filter((type) => type.count > 0);
const groups = filterGroups(searchable, filters);
const selectedType = filters.type;
const typeLabel = types.find((type) => type.slug === selectedType)?.name;
const noindex = Boolean(filters.q || filters.place);
const title = typeLabel ? `${typeLabel} churches` : 'Map';
const description = typeLabel
  ? `${typeLabel} churches in the Charlotte area, with service time and the facts each church states on its own site.`
  : 'Map of churches in the Charlotte area. Filter by church type, service day and time, language, and what the church states on its own site.';
---

<Layout title={title} path="/map" noindex={noindex} description={description}>
  {db ? (
    <div class="page wrap">
      <h1>{typeLabel ? `${typeLabel} churches` : 'Map'}</h1>
      <p class="lede">Choose a church type, then any facts the church states on its own site. Inside one group, any selected choice counts. Every group you use has to match.</p>
      {!attributes.ready && <p class="notice">Ministry and worship filters are not in this database yet. The map still works. Those counts stay at zero until the research is loaded.</p>}
      <form id="map-filters" class="panel">
        <div class="filter-grid">
          <label>Church type
            <select class="field" name="type">
              <option value="">Any type</option>
              {types.map((type) => (
                <option value={type.slug} selected={selectedType === type.slug}>{type.name} ({type.count})</option>
              ))}
            </select>
          </label>
          <label>Name, city, or ZIP
            <input class="field" name="q" value={Astro.url.searchParams.get('q') ?? ''} />
          </label>
          <label>City or ZIP
            <input class="field" name="place" value={Astro.url.searchParams.get('place') ?? ''} placeholder="28205 or Matthews" />
          </label>
        </div>
        <div style="margin-top: 1.15rem">
          <FilterGroups groups={groups} />
        </div>
      </form>
      <p id="map-count" class="count-line">{visibleCount} {visibleCount === 1 ? 'church' : 'churches'}</p>
      <div class="map-layout">
        <div id="church-map" class="map-frame" role="region" aria-label="Church map"></div>
        <div id="map-list" class="schedule"></div>
      </div>
      <noscript>
        <ul class="legend" style="margin-top: 1.5rem">
          {churches.map((church) => (
            <li><a href={`/church/${church.slug}`}>{church.name}</a></li>
          ))}
        </ul>
      </noscript>
      <script id="map-data" type="application/json" set:html={JSON.stringify(searchable).replace(/</g, '\\u003c')}></script>
      <script>
        import { mountMap } from '../scripts/map-page';
        const data = JSON.parse(document.getElementById('map-data')?.textContent || '[]');
        const mapEl = document.getElementById('church-map');
        const listEl = document.getElementById('map-list');
        const countEl = document.getElementById('map-count');
        if (mapEl && listEl && countEl) mountMap(mapEl, listEl, countEl, data);
      </script>
    </div>
  ) : <DatabaseMissing />}
</Layout>
