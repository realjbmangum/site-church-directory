---
import Layout from '../layouts/Layout.astro';
import DatabaseMissing from '../components/DatabaseMissing.astro';
import { getDb } from '../lib/db';
import { listBodies, listLanguages, listOpenChurches } from '../lib/queries';
import { TIME_BUCKETS } from '@shared/time';
import 'leaflet/dist/leaflet.css';

const db = getDb(Astro.locals);
const churches = db ? await listOpenChurches(db) : [];
const bodies = db ? (await listBodies(db)).filter((body) => body.church_count > 0) : [];
const languages = db ? await listLanguages(db) : [];
const params = Astro.url.searchParams;
const payload = churches.map((church) => ({
  slug: church.slug,
  name: church.name,
  lat: church.latitude,
  lng: church.longitude,
  family: church.family_name ?? '',
  familySlug: church.family_slug ?? '',
  body: church.body_name ?? '',
  bodySlug: church.body_slug ?? '',
  city: church.city ?? '',
  zip: church.zip ?? '',
  languages: church.languages_text ?? '',
  minutes: church.earliest_sunday_minutes,
  sunday: church.earliest_sunday_time ?? '',
  address: church.address ?? '',
}));
const families = [...new Map(churches.filter((church) => church.family_slug).map((church) => [church.family_slug, church.family_name])).entries()]
  .map(([slug, name]) => ({ slug: slug as string, name: name as string }))
  .sort((a, b) => a.name.localeCompare(b.name));
const noindex = Astro.url.search.length > 1;
---

<Layout
  title="Map"
  path="/map"
  noindex={noindex}
  description="Map of churches in the Charlotte area. Filter by denomination family, specific body, language, city or ZIP, and Sunday service time."
>
  {db ? (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <h1 class="font-serif text-4xl text-gray-900">Map</h1>
      <p class="mt-2 text-gray-700 max-w-2xl">Denomination family is the main filter. Pick a specific body after that, then language, place, or Sunday time.</p>
      <form id="map-filters" class="card mt-6 p-4 grid gap-3 md:grid-cols-3">
        <label class="block text-sm">Name, city, or ZIP
          <input class="field mt-1" name="q" value={params.get('q') ?? ''} />
        </label>
        <label class="block text-sm">City or ZIP
          <input class="field mt-1" name="place" value={params.get('place') ?? ''} placeholder="28205 or Matthews" />
        </label>
        <label class="block text-sm">Language
          <select class="field mt-1" name="language" id="filter-language">
            <option value="">Any language</option>
            {languages.map((language) => (
              <option value={language.language} selected={params.get('language') === language.language}>{language.language}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">Denomination family
          <select class="field mt-1" name="family" id="filter-family">
            <option value="">Any family</option>
            {families.map((family) => (
              <option value={family.slug} selected={params.get('family') === family.slug}>{family.name}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">Specific body
          <select class="field mt-1" name="body" id="filter-body">
            <option value="">Any body</option>
            {bodies.map((body) => (
              <option value={body.slug} data-family={body.family_slug} selected={params.get('body') === body.slug}>{body.name}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">Sunday service time
          <select class="field mt-1" name="time">
            <option value="">Any time</option>
            {TIME_BUCKETS.map((bucket) => (
              <option value={bucket.id} selected={params.get('time') === bucket.id}>{bucket.label}</option>
            ))}
          </select>
        </label>
      </form>
      <p id="map-count" class="mt-4 text-sm text-gray-600">{churches.length} churches</p>
      <div class="mt-3 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div id="church-map" class="card h-[32rem] overflow-hidden" role="region" aria-label="Church map"></div>
        <div id="map-list" class="space-y-2 max-h-[32rem] overflow-auto"></div>
      </div>
      <noscript>
        <ul class="mt-6 space-y-2">
          {churches.map((church) => (
            <li><a class="text-primary-800" href={`/church/${church.slug}`}>{church.name}</a></li>
          ))}
        </ul>
      </noscript>
      <script id="map-data" type="application/json" set:html={JSON.stringify(payload)}></script>
      <script>
        import { mountMap } from '../scripts/map-page';
        const data = JSON.parse(document.getElementById('map-data')?.textContent || '[]');
        const mapEl = document.getElementById('church-map');
        const listEl = document.getElementById('map-list');
        const countEl = document.getElementById('map-count');
        if (mapEl && listEl && countEl) mountMap(mapEl, listEl, countEl, data);
      </script>
    </div>
  ) : <DatabaseMissing />}
</Layout>
