---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ChurchCard from '../../components/ChurchCard.astro';
import { getDirectory, SERVICE_BUCKETS, serviceBucket } from '../../lib/load';

const directory = getDirectory();
const churches = directory.churches.filter((church) => church.published);
const families = directory.families.filter((family) => family.churchCount > 0);
const languages = [...new Set(churches.flatMap((church) => church.languages))].sort();
---

<Layout title="Churches" description="All churches in the Charlotte pilot, with denomination, city, language, and service time.">
  <PageHeader
    title="Churches"
    lede={`${churches.length} churches in the Charlotte pilot. Filters hide cards on this page. The map uses the same choices.`}
    crumbs={[{ label: 'Churches' }]}
  />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <form id="church-filters" class="card p-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-6 mb-6">
      <label class="block text-sm lg:col-span-2">
        <span class="text-gray-700">City or ZIP</span>
        <input name="place" class="field mt-1" placeholder="Matthews or 28105" />
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Family</span>
        <select name="family" class="field mt-1">
          <option value="">Any</option>
          {families.map((family) => <option value={family.slug}>{family.name}</option>)}
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Body</span>
        <select name="body" class="field mt-1">
          <option value="">Any</option>
          {directory.bodies.filter((body) => body.churchCount > 0).map((body) => (
            <option value={body.slug} data-family={body.familySlug}>{body.name}</option>
          ))}
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Language</span>
        <select name="language" class="field mt-1">
          <option value="">Any</option>
          {languages.map((language) => <option value={language}>{language}</option>)}
        </select>
      </label>
      <label class="block text-sm">
        <span class="text-gray-700">Service time</span>
        <select name="time" class="field mt-1">
          <option value="">Any</option>
          {SERVICE_BUCKETS.filter((bucket) => bucket.id !== 'unknown').map((bucket) => (
            <option value={bucket.id}>{bucket.label}</option>
          ))}
          <option value="saturday">Saturday service</option>
        </select>
      </label>
    </form>
    <p id="church-count" class="text-sm text-gray-600 mb-4">{churches.length} churches</p>
    <div id="church-grid" class="grid md:grid-cols-2 gap-4">
      {churches.map((church) => (
        <div
          class="church-item"
          data-family={church.familySlug}
          data-body={church.bodySlug}
          data-city={church.city || ''}
          data-zip={church.postalCode || ''}
          data-languages={church.languages.join('|')}
          data-bucket={serviceBucket(church)}
          data-saturday={/saturday/i.test(church.serviceTimesText) ? '1' : '0'}
        >
          <ChurchCard church={church} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#church-filters');
  const items = [...document.querySelectorAll<HTMLElement>('.church-item')];
  const count = document.querySelector('#church-count');
  const bodySelect = form?.querySelector<HTMLSelectElement>('[name="body"]');
  const familySelect = form?.querySelector<HTMLSelectElement>('[name="family"]');

  function apply() {
    if (!form) return;
    const data = new FormData(form);
    const family = String(data.get('family') || '');
    const body = String(data.get('body') || '');
    const language = String(data.get('language') || '').toLowerCase();
    const place = String(data.get('place') || '').trim().toLowerCase();
    const time = String(data.get('time') || '');
    let visible = 0;
    for (const item of items) {
      const languages = (item.dataset.languages || '').toLowerCase().split('|');
      const haystack = `${item.dataset.city || ''} ${item.dataset.zip || ''}`.toLowerCase();
      let show = true;
      if (family && item.dataset.family !== family) show = false;
      if (body && item.dataset.body !== body) show = false;
      if (language && !languages.includes(language)) show = false;
      if (place && !haystack.includes(place)) show = false;
      if (time === 'saturday' && item.dataset.saturday !== '1') show = false;
      if (time && time !== 'saturday' && item.dataset.bucket !== time) show = false;
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'church' : 'churches'}`;
  }

  function syncBodies() {
    if (!bodySelect || !familySelect) return;
    const family = familySelect.value;
    for (const option of bodySelect.options) {
      if (!option.value) continue;
      option.hidden = Boolean(family) && option.dataset.family !== family;
    }
    const selected = bodySelect.selectedOptions[0];
    if (selected && selected.hidden) bodySelect.value = '';
  }

  familySelect?.addEventListener('change', () => {
    syncBodies();
    apply();
  });
  form?.addEventListener('input', apply);
  form?.addEventListener('submit', (event) => event.preventDefault());
  syncBodies();
</script>
