---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ChurchCard from '../../components/ChurchCard.astro';
import { getDirectory } from '../../lib/load';

export function getStaticPaths() {
  return getDirectory().cities.map((city) => ({
    params: { slug: city.slug },
    props: { citySlug: city.slug },
  }));
}

const { citySlug } = Astro.props;
const directory = getDirectory();
const city = directory.cities.find((item) => item.slug === citySlug);
if (!city) throw new Error(`Missing city ${citySlug}`);
const churches = directory.churches.filter((church) => church.published && church.citySlug === city.slug);
const pageUrl = new URL(`/cities/${city.slug}`, Astro.site).href;
---

<Layout
  title={`Churches in ${city.name}, ${city.state}`}
  description={`${churches.length} churches in ${city.name}, ${city.state}, from the Charlotte pilot.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Churches in ${city.name}`,
    url: pageUrl,
  }}
>
  <PageHeader
    title={`Churches in ${city.name}`}
    lede={`${churches.length} checked ${churches.length === 1 ? 'church' : 'churches'} in ${city.name}, ${city.state}.`}
    crumbs={[{ href: '/cities', label: 'Cities' }, { label: city.name }]}
  />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <p class="mb-6"><a class="btn-secondary" href={`/map?place=${encodeURIComponent(city.name)}`}>Show on the map</a></p>
    <div class="grid md:grid-cols-2 gap-4">
      {churches.map((church) => <ChurchCard church={church} />)}
    </div>
  </div>
</Layout>
