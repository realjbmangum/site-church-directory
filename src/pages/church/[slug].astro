---
import Layout from '../../layouts/Layout.astro';
import DatabaseMissing from '../../components/DatabaseMissing.astro';
import { getDb } from '../../lib/db';
import { getChurch } from '../../lib/queries';
import { beliefsLink, listAttributes, proofBadges, quoteHint, specificBodyLine, toSearchable } from '../../lib/attributes';
import { directionsUrl, formatChecked, mediaUrl, placeLine, proofLabel, safeHttpUrl, serviceLines, telHref } from '../../lib/format';
import { canonicalUrl } from '../../lib/site';
import 'leaflet/dist/leaflet.css';

const db = getDb(Astro.locals);
const church = db ? await getChurch(db, Astro.params.slug ?? '') : null;
if (db && !church) Astro.response.status = 404;
const closed = church?.status === 'closed';
const path = `/church/${church?.slug ?? ''}`;
const website = safeHttpUrl(church?.website);
const proof = safeHttpUrl(church?.proof_url);
const phone = telHref(church?.phone);
const lines = serviceLines(church?.service_times);
const checked = formatChecked(church?.date_checked);
const photo = mediaUrl(church?.photo_key);
const logo = mediaUrl(church?.logo_key);
const directions = church ? directionsUrl(church) : null;
const attributes = db ? await listAttributes(db) : { rows: [], ready: false };
const attribute = church ? attributes.rows.find((row) => row.church_id === church.id) : undefined;
const facts = church ? toSearchable(church, attribute) : null;
const badges = proofBadges(attribute);
const beliefs = beliefsLink(attribute);
const partOf = church ? specificBodyLine(church, attribute) : null;
const description = church
  ? `${church.name} in ${placeLine(church) || 'the Charlotte area'}. ${facts?.typeName || 'Church type not listed yet'}. Service times as the church lists them.`
  : 'Church listing';

const jsonLd = church
  ? {
      '@context': 'https://schema.org',
      '@type': 'Church',
      name: church.name,
      url: canonicalUrl(path),
      ...(website ? { sameAs: website } : {}),
      ...(church.phone ? { telephone: church.phone } : {}),
      address: {
        '@type': 'PostalAddress',
        ...(church.address ? { streetAddress: church.address } : {}),
        ...(church.city ? { addressLocality: church.city } : {}),
        ...(church.state ? { addressRegion: church.state } : {}),
        ...(church.zip ? { postalCode: church.zip } : {}),
        addressCountry: 'US',
      },
      ...(church.latitude != null && church.longitude != null
        ? { geo: { '@type': 'GeoCoordinates', latitude: church.latitude, longitude: church.longitude } }
        : {}),
      ...(facts?.typeName ? { additionalProperty: { '@type': 'PropertyValue', name: 'churchType', value: facts.typeName } } : {}),
    }
  : null;
---

<Layout title={church?.name ?? 'Church'} path={path} description={description} noindex={closed} jsonLd={jsonLd ?? undefined}>
  {db ? (
    church ? (
      <article class="page wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/charlotte">Charlotte</a>
          {church.city_id && church.city && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/city/${church.city_id}`}>{church.city}</a>
            </>
          )}
          {facts?.typeSlug && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/denomination/${facts.typeSlug}`}>{facts.typeName}</a>
            </>
          )}
        </nav>
        <header class="church-head">
          <div>
            {photo && <img src={photo} alt="" class="stop-photo" style="height: 16rem; margin-bottom: 1rem; border-radius: 12px" />}
            <h1>{church.name}</h1>
            {church.campus_name && <p class="meta" style="margin-top: 0.4rem">Campus: {church.campus_name}</p>}
            <p class="meta" style="margin-top: 0.35rem">{placeLine(church)}</p>
            {partOf && <p class="meta" style="margin-top: 0.2rem">{partOf}</p>}
            <p class="chip-row">
              {facts?.typeName && <a class="badge" href={`/denomination/${facts.typeSlug}`}>{facts.typeName}</a>}
              {church.historically_black_tradition ? <span class="badge">Historically Black tradition</span> : null}
              {closed && <span class="badge badge-closed">Marked closed</span>}
            </p>
          </div>
          {church.earliest_sunday_time && (
            <p>
              <span class="proof-time">{church.earliest_sunday_time}</span>
              <span class="time-caption" style="display: block; margin-top: 0.35rem">Earliest Sunday</span>
            </p>
          )}
        </header>

        {closed && (
          <p class="notice">
            This church is marked closed{church.closed_reason ? `: ${church.closed_reason}` : ''}. The listing stays so the record is not lost.
          </p>
        )}

        <div class="detail-grid" style="margin-top: 1.75rem">
          <div>
            <section class="panel">
              <h2>Service times</h2>
              <p class="quiet">Shown the way the church wrote them.</p>
              {lines ? (
                <ul class="time-list">
                  {lines.map((line) => <li>{line}</li>)}
                </ul>
              ) : (
                <p style="margin-top: 0.8rem; white-space: pre-wrap">{church.service_times || 'No service time was listed on the page we checked.'}</p>
              )}
              {church.earliest_sunday_time && <p class="quiet" style="margin-top: 0.8rem">Earliest Sunday time we could read: {church.earliest_sunday_time}</p>}
            </section>

            <section class="panel" style="margin-top: 1rem">
              <h2>Last verified</h2>
              {proof || church.proof_quote ? (
                <>
                  <p class="quiet" style="margin-top: 0.45rem">{checked ? `Last checked ${checked}.` : 'Checked against the church website.'} The quote below is copied from that page.</p>
                  {church.proof_quote && <blockquote class="proof-quote">{church.proof_quote}</blockquote>}
                  {proofLabel(church.proof_strength) && <p class="quiet" style="margin-top: 0.75rem">{proofLabel(church.proof_strength)}</p>}
                  {proof && <p style="margin-top: 0.75rem"><a class="btn-secondary" href={proof} rel="noopener noreferrer">Read the source</a></p>}
                </>
              ) : (
                <p class="quiet" style="margin-top: 0.45rem">This listing has not been checked against the church website yet. It came in through the desk and is waiting on a source quote.</p>
              )}
            </section>

            {(badges.length > 0 || beliefs) && (
              <section class="panel" style="margin-top: 1rem">
                <h2>From their website</h2>
                <p class="quiet">Shown only when the church's own site says it. If we did not find a fact, it is left off. That is not a no.</p>
                <div class="proof-badges">
                  {badges.map((item) => (
                    <p class="proof-badge">
                      <span>{item.label}</span>
                      {item.url && <a href={item.url} rel="noopener noreferrer" title={quoteHint(attribute, item.label) || undefined}>from their website</a>}
                    </p>
                  ))}
                </div>
                {beliefs && <p style="margin-top: 0.9rem"><a class="btn-secondary" href={beliefs} rel="noopener noreferrer">Beliefs page</a></p>}
              </section>
            )}

            <section class="panel" style="margin-top: 1rem">
              <h2>Church type and languages</h2>
              <dl class="dl-grid">
                <div><dt>Church type</dt><dd>{facts?.typeName || 'Not listed yet'}</dd></div>
                <div><dt>Languages</dt><dd>{church.languages_text || 'Not listed'}</dd></div>
              </dl>
              {facts?.typeSlug && (
                <p style="margin-top: 1rem"><a class="btn-quiet" href={`/denomination/${facts.typeSlug}`}>More {facts.typeName} churches</a></p>
              )}
            </section>

            <p style="margin-top: 1.25rem"><a class="btn-secondary" href={`/church/${church.slug}/suggest`}>Suggest a correction</a></p>
          </div>

          <aside class="panel visit-panel">
            {logo && <img src={logo} alt="" style="height: 4rem; width: auto; margin-bottom: 0.8rem" />}
            <h2>Visit</h2>
            <div class="meta" style="margin-top: 0.75rem; display: grid; gap: 0.7rem">
              {church.address && <p style="color: var(--ink)">{church.address}<br />{placeLine(church)}</p>}
              {phone && church.phone && <p><a href={phone} style="color: var(--spruce-deep); font-weight: 700">{church.phone}</a></p>}
              {website && <p><a href={website} rel="noopener noreferrer" style="color: var(--spruce-deep); font-weight: 700">Church website</a></p>}
            </div>
            {church.latitude != null && church.longitude != null && (
              <div id="detail-map" class="detail-map" data-lat={church.latitude} data-lng={church.longitude} data-name={church.name}></div>
            )}
            {directions && <p style="margin-top: 1rem"><a class="btn-primary" style="width: 100%" href={directions} rel="noopener noreferrer">Directions</a></p>}
          </aside>
        </div>
        <script>
          import { mountDetail } from '../../scripts/map-page';
          const el = document.getElementById('detail-map');
          if (el) {
            const lat = Number(el.dataset.lat);
            const lng = Number(el.dataset.lng);
            if (Number.isFinite(lat) && Number.isFinite(lng)) mountDetail(el, lat, lng, el.dataset.name || 'Church');
          }
        </script>
      </article>
    ) : (
      <div class="page wrap">
        <h1>That church is not in the directory.</h1>
        <p class="lede"><a class="btn-secondary" href="/map">Back to the map</a></p>
      </div>
    )
  ) : <DatabaseMissing />}
</Layout>
