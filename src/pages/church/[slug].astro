---
import Layout from '../../layouts/Layout.astro';
import churches from '../../data/sample-churches.json';

export function getStaticPaths() {
  return churches.map(church => ({
    params: { slug: church.slug },
    props: { church }
  }));
}

const { church } = Astro.props;

// Format phone for tel: link
const phoneLink = church.phone?.replace(/[^\d]/g, '');

// Schema.org structured data for LocalBusiness
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Church",
  "name": church.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": church.address,
    "addressLocality": church.city,
    "addressRegion": church.state,
    "postalCode": church.zip
  },
  "telephone": church.phone,
  "url": church.website,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": church.latitude,
    "longitude": church.longitude
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": church.rating,
    "reviewCount": church.review_count
  }
};
---

<Layout
  title={`${church.name} - ${church.city}, ${church.state}`}
  description={`${church.name} is a ${church.denomination} church in ${church.city}, ${church.state}. ${church.description}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Breadcrumb -->
  <nav class="bg-white border-b border-cream-200 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-gray-500">
        <li><a href="/" class="hover:text-primary-600">Home</a></li>
        <li><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg></li>
        <li><a href="/churches" class="hover:text-primary-600">Churches</a></li>
        <li><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg></li>
        <li><a href={`/churches?city=${church.city.toLowerCase()}`} class="hover:text-primary-600">{church.city}</a></li>
        <li><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg></li>
        <li class="text-gray-900 font-medium truncate">{church.name}</li>
      </ol>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="lg:grid lg:grid-cols-3 lg:gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <!-- Hero Image -->
        <div class="aspect-[16/9] rounded-2xl overflow-hidden mb-6">
          <img
            src={church.photo}
            alt={church.name}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-start justify-between gap-4 mb-3">
            <div>
              <span class="badge badge-denomination mb-2">{church.denomination}</span>
              <h1 class="text-3xl font-serif font-bold text-gray-900">{church.name}</h1>
            </div>
            <div class="flex items-center gap-1 shrink-0 bg-cream-100 px-3 py-2 rounded-lg">
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <span class="font-semibold text-gray-900">{church.rating}</span>
              <span class="text-gray-500">({church.review_count} reviews)</span>
            </div>
          </div>

          <p class="text-lg text-gray-600">{church.description}</p>
        </div>

        <!-- Service Times -->
        <section class="bg-white rounded-xl border border-cream-200 p-6 mb-6">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Service Times
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {church.services.map((service: { day: string; time: string; type: string }) => (
              <div class="flex items-center gap-3 bg-cream-50 rounded-lg p-4">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
                  <span class="text-sm font-semibold text-primary-700">{service.day.slice(0, 3)}</span>
                </div>
                <div>
                  <p class="font-medium text-gray-900">{service.time}</p>
                  <p class="text-sm text-gray-600">{service.type}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- What to Expect -->
        <section class="bg-white rounded-xl border border-cream-200 p-6 mb-6">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4">What to Expect</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-1">Atmosphere</h3>
              <p class="text-gray-900">{church.atmosphere}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-1">Dress Code</h3>
              <p class="text-gray-900">{church.dress_code}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-1">Parking</h3>
              <p class="text-gray-900">{church.parking}</p>
            </div>
          </div>
        </section>

        <!-- Programs & Ministries -->
        <section class="bg-white rounded-xl border border-cream-200 p-6 mb-6">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Programs & Ministries
          </h2>
          <div class="flex flex-wrap gap-2">
            {church.programs.map((program: string) => (
              <span class="badge badge-service text-sm px-3 py-1.5">{program}</span>
            ))}
          </div>
        </section>

        <!-- Accessibility -->
        <section class="bg-white rounded-xl border border-cream-200 p-6">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Accessibility
          </h2>
          <ul class="space-y-2">
            {church.accessibility.map((feature: string) => (
              <li class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1 mt-8 lg:mt-0">
        <div class="bg-white rounded-xl border border-cream-200 p-6 sticky top-24">
          <!-- Contact Info -->
          <h2 class="font-serif text-lg font-semibold text-gray-900 mb-4">Contact & Location</h2>

          <div class="space-y-4 mb-6">
            <!-- Address -->
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                <p class="text-gray-900">{church.address}</p>
                <p class="text-gray-600">{church.city}, {church.state} {church.zip}</p>
              </div>
            </div>

            <!-- Phone -->
            {church.phone && (
              <a href={`tel:${phoneLink}`} class="flex items-center gap-3 text-gray-900 hover:text-primary-600 transition-colors">
                <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {church.phone}
              </a>
            )}

            <!-- Email -->
            {church.email && (
              <a href={`mailto:${church.email}`} class="flex items-center gap-3 text-gray-900 hover:text-primary-600 transition-colors">
                <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                {church.email}
              </a>
            )}

            <!-- Website -->
            {church.website && (
              <a href={church.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-900 hover:text-primary-600 transition-colors">
                <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                Visit Website
              </a>
            )}
          </div>

          <!-- Map -->
          <div class="aspect-[4/3] rounded-lg bg-cream-100 mb-6 overflow-hidden">
            <iframe
              width="100%"
              height="100%"
              style="border:0"
              loading="lazy"
              allowfullscreen
              src={`https://www.google.com/maps/embed/v1/place?key=YOUR_API_KEY&q=${encodeURIComponent(church.address + ', ' + church.city + ', ' + church.state)}`}
            ></iframe>
          </div>

          <!-- CTA Buttons -->
          <div class="space-y-3">
            <a
              href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(church.address + ', ' + church.city + ', ' + church.state)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full justify-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              Get Directions
            </a>

            {church.website && (
              <a href={church.website} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full justify-center">
                Plan Your Visit
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
