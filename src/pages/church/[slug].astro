---
import Layout from '../../layouts/Layout.astro';
import DatabaseMissing from '../../components/DatabaseMissing.astro';
import { getDb } from '../../lib/db';
import { getChurch } from '../../lib/queries';
import { directionsUrl, formatChecked, mediaUrl, placeLine, proofLabel, safeHttpUrl, serviceLines, telHref } from '../../lib/format';
import { canonicalUrl } from '../../lib/site';
import 'leaflet/dist/leaflet.css';

const db = getDb(Astro.locals);
const church = db ? await getChurch(db, Astro.params.slug ?? '') : null;
if (db && !church) Astro.response.status = 404;
const closed = church?.status === 'closed';
const path = `/church/${church?.slug ?? ''}`;
const website = safeHttpUrl(church?.website);
const proof = safeHttpUrl(church?.proof_url);
const phone = telHref(church?.phone);
const lines = serviceLines(church?.service_times);
const checked = formatChecked(church?.date_checked);
const photo = mediaUrl(church?.photo_key);
const logo = mediaUrl(church?.logo_key);
const directions = church ? directionsUrl(church) : null;
const description = church
  ? `${church.name} in ${placeLine(church) || 'the Charlotte area'}. ${church.family_name || 'Denomination not stated'}. Service times as the church lists them.`
  : 'Church listing';

const jsonLd = church
  ? {
      '@context': 'https://schema.org',
      '@type': 'Church',
      name: church.name,
      url: canonicalUrl(path),
      ...(website ? { sameAs: website } : {}),
      ...(church.phone ? { telephone: church.phone } : {}),
      address: {
        '@type': 'PostalAddress',
        ...(church.address ? { streetAddress: church.address } : {}),
        ...(church.city ? { addressLocality: church.city } : {}),
        ...(church.state ? { addressRegion: church.state } : {}),
        ...(church.zip ? { postalCode: church.zip } : {}),
        addressCountry: 'US',
      },
      ...(church.latitude != null && church.longitude != null
        ? { geo: { '@type': 'GeoCoordinates', latitude: church.latitude, longitude: church.longitude } }
        : {}),
      ...(church.family_name ? { additionalProperty: { '@type': 'PropertyValue', name: 'denomination', value: church.body_name || church.family_name } } : {}),
    }
  : null;
---

<Layout title={church?.name ?? 'Church'} path={path} description={description} noindex={closed} jsonLd={jsonLd ?? undefined}>
  {db ? (
    church ? (
      <article class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <p class="text-sm text-gray-600">
          <a href="/charlotte" class="hover:text-primary-700">Charlotte</a>
          {church.city_id && church.city && (
            <>
              <span class="px-1">/</span>
              <a href={`/city/${church.city_id}`} class="hover:text-primary-700">{church.city}</a>
            </>
          )}
          {church.family_slug && (
            <>
              <span class="px-1">/</span>
              <a href={`/denomination/${church.family_slug}`} class="hover:text-primary-700">{church.family_name}</a>
            </>
          )}
        </p>
        <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div>
            {photo && <img src={photo} alt="" class="w-full max-h-80 object-cover rounded-2xl mb-6" />}
            <div class="flex flex-wrap items-center gap-2">
              {church.family_name && <span class="badge">{church.family_name}</span>}
              {church.historically_black_tradition ? <span class="badge">Historically Black tradition</span> : null}
              {closed && <span class="badge">Marked closed</span>}
            </div>
            <h1 class="mt-3 font-serif text-4xl text-gray-900">{church.name}</h1>
            {church.campus_name && <p class="mt-1 text-gray-700">Campus: {church.campus_name}</p>}
            <p class="mt-2 text-gray-600">{placeLine(church)}</p>

            {closed && (
              <p class="mt-4 card p-4 bg-cream-50 text-gray-800">
                This church is marked closed{church.closed_reason ? `: ${church.closed_reason}` : ''}. The listing stays so the record is not lost.
              </p>
            )}

            <section class="card p-5 mt-6">
              <h2 class="font-serif text-2xl">Service times</h2>
              <p class="mt-1 text-sm text-gray-600">Shown the way the church wrote them.</p>
              {lines ? (
                <ul class="mt-4 space-y-2">
                  {lines.map((line) => <li class="bg-cream-100 rounded-lg px-3 py-2">{line}</li>)}
                </ul>
              ) : (
                <p class="mt-4 text-gray-800 whitespace-pre-wrap">{church.service_times || 'No service time was listed on the page we checked.'}</p>
              )}
              {church.earliest_sunday_time && <p class="mt-3 text-sm text-gray-600">Earliest Sunday time we could read: {church.earliest_sunday_time}</p>}
            </section>

            <section class="card p-5 mt-4">
              <h2 class="font-serif text-2xl">Last verified</h2>
              {proof || church.proof_quote ? (
                <>
                  <p class="mt-2 text-gray-700">{checked ? `Last checked ${checked}.` : 'Checked against the church website.'} The quote below is copied from that page.</p>
                  {church.proof_quote && <blockquote class="mt-4 bg-cream-100 rounded-xl px-4 py-3 text-gray-900">{church.proof_quote}</blockquote>}
                  {proofLabel(church.proof_strength) && <p class="mt-3 text-sm text-gray-600">{proofLabel(church.proof_strength)}</p>}
                  {proof && <p class="mt-3"><a class="text-primary-800 font-medium" href={proof} rel="noopener noreferrer">Read the source</a></p>}
                </>
              ) : (
                <p class="mt-2 text-gray-700">This listing has not been checked against the church website yet. It came in through the desk and is waiting on a source quote.</p>
              )}
            </section>

            <section class="card p-5 mt-4">
              <h2 class="font-serif text-2xl">Denomination and languages</h2>
              <dl class="mt-3 grid gap-3 sm:grid-cols-2 text-sm">
                <div><dt class="text-gray-500">Family</dt><dd class="text-gray-900">{church.family_name || 'Not stated'}</dd></div>
                <div><dt class="text-gray-500">Specific body</dt><dd class="text-gray-900">{church.body_name || 'Not stated'}</dd></div>
                <div><dt class="text-gray-500">Languages</dt><dd class="text-gray-900">{church.languages_text || 'Not listed'}</dd></div>
                {church.denomination_evidence && <div><dt class="text-gray-500">How we know the body</dt><dd class="text-gray-900">{church.denomination_evidence}</dd></div>}
              </dl>
              {church.body_slug && church.family_slug && (
                <p class="mt-4 text-sm"><a class="text-primary-800" href={`/denomination/${church.family_slug}/${church.body_slug}`}>More {church.body_name} churches</a></p>
              )}
            </section>

            <p class="mt-6 text-sm"><a class="text-primary-800" href={`/church/${church.slug}/suggest`}>Suggest a correction</a></p>
          </div>

          <aside class="card p-5 h-fit lg:sticky lg:top-24">
            {logo && <img src={logo} alt="" class="h-16 w-auto mb-4" />}
            <h2 class="font-serif text-xl">Visit</h2>
            <div class="mt-3 space-y-3 text-sm">
              {church.address && <p>{church.address}<br />{placeLine(church)}</p>}
              {phone && church.phone && <p><a class="text-primary-800" href={phone}>{church.phone}</a></p>}
              {website && <p><a class="text-primary-800" href={website} rel="noopener noreferrer">Church website</a></p>}
            </div>
            {church.latitude != null && church.longitude != null && (
              <div id="detail-map" class="mt-4 h-48 rounded-xl overflow-hidden border border-cream-300" data-lat={church.latitude} data-lng={church.longitude} data-name={church.name}></div>
            )}
            {directions && <p class="mt-4"><a class="btn-primary w-full" href={directions} rel="noopener noreferrer">Directions</a></p>}
          </aside>
        </div>
        <script>
          import { mountDetail } from '../../scripts/map-page';
          const el = document.getElementById('detail-map');
          if (el) {
            const lat = Number(el.dataset.lat);
            const lng = Number(el.dataset.lng);
            if (Number.isFinite(lat) && Number.isFinite(lng)) mountDetail(el, lat, lng, el.dataset.name || 'Church');
          }
        </script>
      </article>
    ) : (
      <div class="max-w-xl mx-auto px-4 py-20">
        <h1 class="font-serif text-3xl">That church is not in the directory.</h1>
        <p class="mt-3"><a class="text-primary-700" href="/map">Back to the map</a></p>
      </div>
    )
  ) : <DatabaseMissing />}
</Layout>
