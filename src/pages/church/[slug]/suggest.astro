---
import Layout from '../../../layouts/Layout.astro';
import DatabaseMissing from '../../../components/DatabaseMissing.astro';
import { getDb } from '../../../lib/db';
import { getChurch } from '../../../lib/queries';

const db = getDb(Astro.locals);
const church = db ? await getChurch(db, Astro.params.slug ?? '') : null;
if (db && !church) Astro.response.status = 404;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout
  title={church ? `Suggest a correction for ${church.name}` : 'Suggest a correction'}
  path={church ? `/church/${church.slug}/suggest` : '/map'}
  noindex={true}
  description="Suggest a correction. It is reviewed before the listing changes."
>
  {db ? (
    church ? (
      <div class="page wrap" style="max-width: 40rem">
        <p><a href={`/church/${church.slug}`} style="color: var(--spruce-deep); font-weight: 700">{church.name}</a></p>
        <h1 style="margin-top: 0.4rem">Suggest a correction</h1>
        <p class="lede">Write what should change. The public listing stays as it is until the correction is approved. Leave a field blank if it is already right.</p>
        {sent && <p class="notice notice-ok" role="status">Thanks. The suggestion is in the queue.</p>}
        {error === 'missing' && <p class="notice notice-error" role="alert">Add a short note about what should change.</p>}
        <form method="post" action="/api/suggest" class="form-card">
          <input type="hidden" name="church" value={church.slug} />
          <label>What should change
            <textarea class="field" name="message" required rows="4" maxlength="2000"></textarea>
          </label>
          <label>Service times
            <textarea class="field" name="service_times" rows="3" maxlength="2000" placeholder={church.service_times || ''}></textarea>
          </label>
          <label>Phone
            <input class="field" name="phone" maxlength="40" placeholder={church.phone || ''} />
          </label>
          <label>Website
            <input class="field" name="website" maxlength="300" placeholder={church.website || ''} />
          </label>
          <label>Street address
            <input class="field" name="address" maxlength="300" placeholder={church.address || ''} />
          </label>
          <div class="filter-grid" style="margin-top: 0; padding: 0; border: 0; background: transparent">
            <label>City
              <input class="field" name="city" maxlength="80" placeholder={church.city || ''} />
            </label>
            <label>State
              <input class="field" name="state" maxlength="2" placeholder={church.state || ''} />
            </label>
            <label>ZIP
              <input class="field" name="zip" maxlength="10" placeholder={church.zip || ''} />
            </label>
          </div>
          <label>Languages
            <input class="field" name="languages_text" maxlength="200" placeholder={church.languages_text || ''} />
          </label>
          <label>Your name
            <input class="field" name="contact_name" maxlength="120" />
          </label>
          <label>Your email
            <input class="field" name="contact_email" type="email" maxlength="200" />
          </label>
          <label class="sr-only" aria-hidden="true">Leave this blank
            <input name="company_fax" tabindex="-1" autocomplete="off" />
          </label>
          <button class="btn-primary" type="submit">Send the suggestion</button>
        </form>
      </div>
    ) : (
      <div class="page wrap">
        <h1>That church is not in the directory.</h1>
      </div>
    )
  ) : <DatabaseMissing />}
</Layout>
