{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "church-directory",
  // @astrojs/cloudflare 12.6 writes the Worker to dist/_worker.js/index.js
  // and copies client files into dist/. The handler fetches those files with env.ASSETS.
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Existing D1 and R2 resources. Deploy of this Worker is approved.
  // Do not provision new resources, attach a domain, or apply migrations with --remote from this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-directory",
      "database_id": "7aeb3846-7268-45bb-bb4d-dcd567cb84bd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "church-directory-assets"
    }
  ]
}
